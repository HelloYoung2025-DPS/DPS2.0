{
  "module": "Extension",
  "version": "1.0.0",
  "file": "Modules/Extension.cs",
  "updated_at": "2026-02-23",
  "contract_format": "1.0",
  "callable": [
    {
      "name": "Run",
      "params": [
        {
          "name": "projectObj",
          "type": "object"
        }
      ],
      "returns": "string",
      "description": "模块入口点，通过 ExtensionManager 注册并执行所有内置扩展。流程：初始化 CoreHelper → 注册内置扩展（IPLocation、Weather）→ 从 ExtensionsRegistry.json 加载配置并初始化 → 按类别执行（DataSource、Hook）→ 输出状态摘要。返回 SUCCESS 或 ERROR:..."
    }
  ],
  "shared_state": {
    "reads": [
      {
        "name": "project_root",
        "type": "ZD变量",
        "description": "项目根目录路径"
      },
      {
        "name": "ExtensionsRegistry.json",
        "type": "文件",
        "description": "扩展注册表，包含各扩展的启用状态和专属配置"
      },
      {
        "name": "ExtensionsConfig.json",
        "type": "文件",
        "description": "扩展全局配置"
      }
    ],
    "writes": [
      {
        "name": "extension_result",
        "type": "ZD变量",
        "description": "模块执行结果（SUCCESS/ERROR）"
      },
      {
        "name": "last_error",
        "type": "ZD变量",
        "description": "最近一次异常信息"
      }
    ]
  },
  "types_defined": [],
  "depends_on": [
    "CoreHelper",
    "ExtensionManager",
    "IPLocationExtension",
    "WeatherExtension"
  ],
  "depended_by": [
    "Main"
  ],
  "side_effects": [
    "ZD variable write",
    "logging"
  ],
  "stability": "stable"
}
