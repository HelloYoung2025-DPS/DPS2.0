{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/artifact.descriptor.v1.schema.json",
  "title": "artifact.descriptor/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "producer_module", "soul_id",
    "device_binding_id", "platform_account_id", "trace_id",
    "idempotency_key", "occurred_at", "privacy_class", "artifact_id",
    "build_id", "module_id", "module_version", "integration_commit",
    "artifact_uri", "artifact_file", "artifact_sha256", "size_bytes",
    "merge_decision_id", "trusted_merge_policy_sha256",
    "source_tree_sha256", "agents_sha256", "manifest_sha256", "sbom",
    "provenance", "signature"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "artifact.descriptor/v1"},
    "producer_module": {"const": "factory-artifact-builder"},
    "soul_id": {"type": ["string", "null"], "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": ["string", "null"], "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": ["string", "null"], "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "privacy_class": {"const": "internal"},
    "artifact_id": {"type": "string", "pattern": "^artifact-[0-9a-f]{32}$(?![\\s\\S])"},
    "build_id": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$(?![\\s\\S])"},
    "module_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])"},
    "module_version": {"type": "string", "minLength": 5},
    "integration_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"},
    "artifact_uri": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"},
    "artifact_file": {"type": "string", "pattern": "^[a-z0-9][A-Za-z0-9._-]+$(?![\\s\\S])"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "merge_decision_id": {"type": "string", "pattern": "^merge-[0-9a-f]{32}$(?![\\s\\S])"},
    "trusted_merge_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "agents_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "sbom": {"$ref": "#/$defs/metadata"},
    "provenance": {"$ref": "#/$defs/metadata"},
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "signer_required"],
      "properties": {
        "status": {"const": "UNSIGNED_AWAITING_EXTERNAL_SIGNER"},
        "signer_required": {"const": "external-controlled-signer"}
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "media_type"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$(?![\\s\\S])"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
        "media_type": {"const": "application/json"}
      }
    }
  }
}
