{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/artifact.build.request.v1.schema.json",
  "title": "artifact.build.request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "producer_module", "soul_id",
    "device_binding_id", "platform_account_id", "trace_id",
    "idempotency_key", "occurred_at", "privacy_class", "build_id",
    "module_id", "module_version", "integration_commit", "artifact_path",
    "expected_sha256", "merge_decision_id"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "artifact.build.request/v1"},
    "producer_module": {"const": "factory-release-controller"},
    "soul_id": {"type": ["string", "null"], "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": ["string", "null"], "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": ["string", "null"], "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "privacy_class": {"const": "internal"},
    "build_id": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$(?![\\s\\S])"},
    "module_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])"},
    "module_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$(?![\\s\\S])"},
    "integration_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"},
    "artifact_path": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!.*\\s$(?![\\s\\S]))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$(?![\\s\\S])"
    },
    "expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "merge_decision_id": {"type": "string", "pattern": "^merge-[0-9a-f]{32}$(?![\\s\\S])"}
  }
}
