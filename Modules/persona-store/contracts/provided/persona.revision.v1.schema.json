{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/persona.revision.v1.schema.json",
  "title": "persona.revision/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "producer_module", "soul_id", "device_binding_id", "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class", "persona_revision", "traits_sha256", "trait_keys", "evidence_sha256", "status"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^1(?:\\.[0-9]+){0,2}$(?![\\s\\S])"},
    "contract_id": {"const": "persona.revision/v1"},
    "producer_module": {"const": "persona-store"},
    "soul_id": {"type": "string", "minLength": 69, "maxLength": 69, "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": "string", "minLength": 35, "maxLength": 35, "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": "string", "minLength": 35, "maxLength": 35, "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "minLength": 38, "maxLength": 38, "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "minLength": 69, "maxLength": 69, "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time", "minLength": 20, "maxLength": 33, "pattern": "^(?:20[2-9][0-9]|21[0-9]{2})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,7})?(?:Z|\\+00:00)$(?![\\s\\S])"},
    "privacy_class": {"const": "personal"},
    "persona_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "traits_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "trait_keys": {"type": "array", "maxItems": 5, "uniqueItems": true, "x-dps-order": "ordinal-ascending", "items": {"enum": ["curiosity", "humor", "pace", "sociality", "tone"]}},
    "evidence_sha256": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "x-dps-order": "ordinal-ascending", "items": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"}},
    "status": {"enum": ["active", "deleted"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "deleted"}}, "required": ["status"]},
      "then": {"properties": {"trait_keys": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"const": "active"}}, "required": ["status"]},
      "then": {"properties": {"trait_keys": {"minItems": 1}}}
    }
  ]
}
