{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/release.bom.native.stop.authority.trust.v1.schema.json",
  "title": "release.bom.native.stop.authority.trust/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "producer_module", "soul_id",
    "device_binding_id", "platform_account_id", "trace_id", "idempotency_key",
    "occurred_at", "privacy_class", "receipt_id", "release_bom_id",
    "release_bom_sha256", "integration_commit", "release_bom_generation",
    "activation_token_sha256", "trust_policy_id", "native_stop_authorities_sha256",
    "device_route_assignment_authorities_sha256", "native_stop_challenge_authorities_sha256",
    "authority_sets_sha256", "native_stop_authorities",
    "device_route_assignment_authorities", "native_stop_challenge_authorities", "signature"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "contract_id": { "const": "release.bom.native.stop.authority.trust/v1" },
    "producer_module": { "const": "factory-release-controller" },
    "soul_id": { "const": null },
    "device_binding_id": { "const": null },
    "platform_account_id": { "const": null },
    "trace_id": { "type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])" },
    "idempotency_key": { "type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])" },
    "occurred_at": { "$ref": "#/$defs/canonicalRuntimeUtc" },
    "privacy_class": { "const": "internal" },
    "receipt_id": { "type": "string", "pattern": "^native-stop-trust-[0-9a-f]{32}$(?![\\s\\S])" },
    "release_bom_id": { "$ref": "#/$defs/id" },
    "release_bom_sha256": { "$ref": "#/$defs/sha256" },
    "integration_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$(?![\\s\\S])" },
    "release_bom_generation": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "activation_token_sha256": { "$ref": "#/$defs/sha256" },
    "trust_policy_id": { "$ref": "#/$defs/id" },
    "native_stop_authorities_sha256": { "$ref": "#/$defs/sha256" },
    "device_route_assignment_authorities_sha256": { "$ref": "#/$defs/sha256" },
    "native_stop_challenge_authorities_sha256": { "$ref": "#/$defs/sha256" },
    "authority_sets_sha256": { "$ref": "#/$defs/sha256" },
    "native_stop_authorities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/nativeStopAuthority" }
    },
    "device_route_assignment_authorities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/deviceRouteAssignmentAuthority" }
    },
    "native_stop_challenge_authorities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/nativeStopChallengeAuthority" }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "rsa-pss-sha256" },
        "key_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "value": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$(?![\\s\\S])" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$(?![\\s\\S])" },
    "nativeStopAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id", "producer_module", "worker_module_id", "worker_artifact_id",
        "worker_artifact_sha256", "worker_version", "worker_slot", "worker_instance_id",
        "worker_generation", "key_id", "p256_spki_sha256", "signature_algorithm",
        "signature_format", "auth_scope", "native_stop_contract_id", "policy_id", "release_bom_generation",
        "activation_token_sha256", "rotation_epoch", "valid_from", "valid_until",
        "revoked", "worker_authority_sha256"
      ],
      "properties": {
        "authority_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$(?![\\s\\S])" },
        "producer_module": { "const": "windows-edge-worker" },
        "worker_module_id": { "const": "windows-edge-worker" },
        "worker_artifact_id": { "const": "dps.windows-edge-worker" },
        "worker_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "worker_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$(?![\\s\\S])" },
        "worker_slot": { "enum": ["A", "B"] },
        "worker_instance_id": { "type": "string", "pattern": "^wi_[0-9a-f]{32}$(?![\\s\\S])" },
        "worker_generation": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "key_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$(?![\\s\\S])" },
        "p256_spki_sha256": { "$ref": "#/$defs/sha256" },
        "signature_algorithm": { "const": "ECDSA_P256_SHA256" },
        "signature_format": { "const": "IEEE_P1363_FIXED_FIELD" },
        "auth_scope": { "const": "policy-approval:native-stop-proof:v2:commit-unknown" },
        "native_stop_contract_id": { "const": "native.stop.proof/v2" },
        "policy_id": { "const": "RESULT-VERIFY-001" },
        "release_bom_generation": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "activation_token_sha256": { "$ref": "#/$defs/sha256" },
        "rotation_epoch": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "valid_from": { "$ref": "#/$defs/canonicalRuntimeUtc" },
        "valid_until": { "$ref": "#/$defs/canonicalRuntimeUtc" },
        "revoked": { "const": false },
        "worker_authority_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "deviceRouteAssignmentAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_authority_id", "producer_module", "supervisor_module_id",
        "supervisor_artifact_id", "supervisor_artifact_sha256", "supervisor_version",
        "supervisor_instance_id", "supervisor_generation", "route_signer_key_id",
        "route_signer_p256_spki_sha256", "signature_algorithm", "signature_format",
        "auth_scope", "policy_id", "release_bom_generation", "activation_token_sha256",
        "rotation_epoch", "valid_from", "valid_until", "revoked", "route_authority_sha256"
      ],
      "properties": {
        "route_authority_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$(?![\\s\\S])" },
        "producer_module": { "const": "factory-release-controller" },
        "supervisor_module_id": { "const": "windows-edge-supervisor" },
        "supervisor_artifact_id": { "const": "dps.windows-edge-supervisor" },
        "supervisor_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "supervisor_version": { "$ref": "#/$defs/strictSemver" },
        "supervisor_instance_id": { "type": "string", "pattern": "^si_[0-9a-f]{32}$(?![\\s\\S])" },
        "supervisor_generation": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "route_signer_key_id": { "type": "string", "pattern": "^p256_spki_[0-9a-f]{64}$(?![\\s\\S])" },
        "route_signer_p256_spki_sha256": { "$ref": "#/$defs/sha256" },
        "signature_algorithm": { "const": "ECDSA_P256_SHA256" },
        "signature_format": { "const": "IEEE_P1363_FIXED_FIELD_LOW_S" },
        "auth_scope": { "const": "windows-edge-supervisor:device-route-assignment:issue" },
        "policy_id": { "const": "SOUL-ISO-001" },
        "release_bom_generation": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "activation_token_sha256": { "$ref": "#/$defs/sha256" },
        "rotation_epoch": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "valid_from": { "$ref": "#/$defs/canonicalRuntimeUtc" },
        "valid_until": { "$ref": "#/$defs/canonicalRuntimeUtc" },
        "revoked": { "const": false },
        "route_authority_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nativeStopChallengeAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id", "producer_module", "policy_module_id", "policy_artifact_id",
        "policy_artifact_sha256", "policy_version", "policy_instance_id",
        "policy_generation", "key_id", "p256_spki_sha256", "signature_algorithm",
        "signature_format", "auth_scope", "native_stop_challenge_contract_id",
        "policy_id", "release_bom_generation", "activation_token_sha256",
        "rotation_epoch", "valid_from", "valid_until", "revoked",
        "challenge_authority_sha256"
      ],
      "properties": {
        "authority_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$(?![\\s\\S])" },
        "producer_module": { "const": "policy-approval" },
        "policy_module_id": { "const": "policy-approval" },
        "policy_artifact_id": { "const": "dps.policy-approval" },
        "policy_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "policy_version": { "$ref": "#/$defs/strictSemver" },
        "policy_instance_id": { "type": "string", "pattern": "^pi_[0-9a-f]{32}$(?![\\s\\S])" },
        "policy_generation": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "key_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$(?![\\s\\S])" },
        "p256_spki_sha256": { "$ref": "#/$defs/sha256" },
        "signature_algorithm": { "const": "ECDSA_P256_SHA256" },
        "signature_format": { "const": "IEEE_P1363_FIXED_FIELD_LOW_S" },
        "auth_scope": { "const": "policy-approval:native-stop-challenge:v1:issue" },
        "native_stop_challenge_contract_id": { "const": "native.stop.challenge/v1" },
        "policy_id": { "const": "NATIVE-STOP-CHALLENGE-001" },
        "release_bom_generation": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "activation_token_sha256": { "$ref": "#/$defs/sha256" },
        "rotation_epoch": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "valid_from": { "$ref": "#/$defs/canonicalRuntimeUtc" },
        "valid_until": { "$ref": "#/$defs/canonicalRuntimeUtc" },
        "revoked": { "const": false },
        "challenge_authority_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "strictSemver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$(?![\\s\\S])" },
    "canonicalRuntimeUtc": { "type": "string", "format": "date-time", "pattern": "^(?:20(?:2[0-9]|[3-9][0-9])|2[1-9][0-9]{2}|[3-9][0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{7}Z$(?![\\s\\S])" }
  }
}
