{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/rollout.event.v2.schema.json",
  "title": "rollout.event/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "producer_module", "soul_id", "device_binding_id",
    "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class",
    "rollout_event_id", "upgrade_id", "previous_state", "current_state", "risk_tier",
    "actor_identity", "actor_role", "bom_sha256", "artifact_sha256", "evidence_kind",
    "verification_level", "simulation_only", "side_effect_count", "kill_switch_armed",
    "transition_request_sha256", "trusted_facts_sha256", "candidate_validation_sha256",
    "receipt_set_sha256", "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "contract_id": {"const": "rollout.event/v2"},
    "producer_module": {"const": "factory-release-controller"},
    "soul_id": {"type": ["string", "null"], "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": ["string", "null"], "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": ["string", "null"], "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)(?:(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26]))|(?:(?:[02468][048]|[13579][26])00))-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$(?![\\s\\S])"
    },
    "privacy_class": {"const": "internal"},
    "rollout_event_id": {"type": "string", "pattern": "^rollout-[0-9a-f]{32}$(?![\\s\\S])"},
    "upgrade_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9]|[._:-](?=[a-z0-9])){7,127}$(?![\\s\\S])"},
    "previous_state": {"$ref": "#/$defs/state"},
    "current_state": {"$ref": "#/$defs/state"},
    "risk_tier": {"enum": ["R0", "R1", "R2", "R3"]},
    "actor_identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$(?![\\s\\S])"},
    "actor_role": {"const": "release-controller"},
    "bom_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "evidence_kind": {"enum": ["REPOSITORY", "CONTRACT", "INTEGRATION", "SIMULATION", "WINDOWS", "DEVICE", "CANARY", "SCALE"]},
    "verification_level": {"enum": ["REPOSITORY_STATIC_VERIFIED", "CONTRACT_VERIFIED", "INTEGRATION_VERIFIED", "WINDOWS_VERIFIED", "DEVICE_VERIFIED", "CANARY_VERIFIED", "SCALE_VERIFIED"]},
    "simulation_only": {"type": "boolean"},
    "side_effect_count": {"type": "integer", "minimum": 0},
    "kill_switch_armed": {"type": "boolean"},
    "transition_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "trusted_facts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "candidate_validation_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "receipt_set_sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$(?![\\s\\S])"},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^receipt:(?:approval|artifact|candidate|canary|evidence|impact|instruction|merge|rollback|shadow|test|worktree):[a-z0-9](?:[a-z0-9]|[._-](?=[a-z0-9])){7,127}$(?![\\s\\S])"
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_kind": {"const": "SIMULATION"}}, "required": ["evidence_kind"]},
      "then": {
        "properties": {
          "verification_level": {"const": "INTEGRATION_VERIFIED"},
          "simulation_only": {"const": true},
          "side_effect_count": {"const": 0}
        }
      }
    },
    {
      "if": {"properties": {"simulation_only": {"const": true}}, "required": ["simulation_only"]},
      "then": {
        "properties": {
          "evidence_kind": {"const": "SIMULATION"},
          "verification_level": {"const": "INTEGRATION_VERIFIED"},
          "side_effect_count": {"const": 0}
        }
      }
    },
    {
      "if": {"properties": {"current_state": {"const": "SHADOW"}}, "required": ["current_state"]},
      "then": {
        "properties": {
          "kill_switch_armed": {"const": true},
          "side_effect_count": {"const": 0},
          "verification_level": {
            "enum": ["INTEGRATION_VERIFIED", "WINDOWS_VERIFIED", "DEVICE_VERIFIED", "CANARY_VERIFIED", "SCALE_VERIFIED"]
          }
        }
      }
    },
    {
      "if": {"properties": {"current_state": {"const": "CANARY"}}, "required": ["current_state"]},
      "then": {
        "properties": {
          "kill_switch_armed": {"const": true},
          "simulation_only": {"const": false},
          "evidence_kind": {"enum": ["DEVICE", "CANARY"]},
          "verification_level": {"enum": ["DEVICE_VERIFIED", "CANARY_VERIFIED", "SCALE_VERIFIED"]}
        }
      }
    },
    {
      "if": {
        "properties": {"current_state": {"enum": ["ROLLING", "SOAKING", "COMPLETED"]}},
        "required": ["current_state"]
      },
      "then": {
        "properties": {
          "kill_switch_armed": {"const": true},
          "simulation_only": {"const": false},
          "evidence_kind": {"enum": ["CANARY", "SCALE"]},
          "verification_level": {"enum": ["CANARY_VERIFIED", "SCALE_VERIFIED"]}
        }
      }
    },
    {
      "if": {"properties": {"current_state": {"const": "BOM_SIGNED"}}, "required": ["current_state"]},
      "then": {
        "properties": {
          "bom_sha256": {"type": "string"},
          "artifact_sha256": {"type": "string"},
          "candidate_validation_sha256": {"type": "string"}
        }
      }
    }
  ],
  "$defs": {
    "state": {
      "enum": [
        "REQUESTED", "SCOPE_RESOLVED", "INSTRUCTIONS_BOUND", "BASELINE_VERIFIED",
        "CONTRACT_FROZEN", "IMPLEMENTING", "CHANGESET_FROZEN", "CANDIDATE_BUILT",
        "CANDIDATE_VERIFIED", "BOM_SIGNED", "SHADOW", "CANARY", "ROLLING",
        "SOAKING", "COMPLETED", "STALE", "REWORKING", "WAITING_EXTERNAL",
        "QUARANTINED", "ROLLBACK_REQUIRED", "ROLLING_BACK", "ROLLED_BACK",
        "FAILED", "CANCELLED"
      ]
    }
  }
}
