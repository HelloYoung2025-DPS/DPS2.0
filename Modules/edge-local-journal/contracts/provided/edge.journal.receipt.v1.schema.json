{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/edge.journal.receipt.v1.schema.json",
  "title": "Edge local journal durable receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "producer_module",
    "request_producer_module",
    "soul_id",
    "device_binding_id",
    "platform_account_id",
    "trace_id",
    "idempotency_key",
    "occurred_at",
    "privacy_class",
    "command_id",
    "entry_id",
    "entry_type",
    "payload_sha256",
    "sequence",
    "previous_checksum",
    "entry_checksum",
    "durable",
    "duplicate"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_id": {"const": "edge.journal.receipt/v1"},
    "producer_module": {"const": "edge-local-journal"},
    "request_producer_module": {"enum": ["windows-edge-worker"]},
    "soul_id": {"type": "string", "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": "string", "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": "string", "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time", "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|\\+00:00)$(?![\\s\\S])"},
    "privacy_class": {"enum": ["internal", "personal", "sensitive"]},
    "command_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$(?![\\s\\S])"},
    "entry_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$(?![\\s\\S])"},
    "entry_type": {"type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[A-Z][A-Z0-9_]{2,63}$(?![\\s\\S])"},
    "payload_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "previous_checksum": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "entry_checksum": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "durable": {"const": true},
    "duplicate": {"type": "boolean"}
  }
}
