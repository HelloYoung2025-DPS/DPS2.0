{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/edge.journal.drain.attestation.v1.schema.json",
  "title": "Edge Journal durable drain attestation v1",
  "x-dps-auth-spec": "edge.journal.drain.attestation.v1.auth.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "producer_module", "request_producer_module",
    "soul_id", "device_binding_id", "platform_account_id", "trace_id",
    "idempotency_key", "occurred_at", "privacy_class", "request_id", "drain_id",
    "command_id", "entry_id", "entry_type", "entry_sequence", "entry_checksum",
    "entry_payload_sha256", "journal_id", "journal_file_sha256",
    "journal_file_identity_sha256", "journal_head_sequence", "journal_head_checksum",
    "checksum_encoding", "range_start_sequence", "range_end_sequence", "range_entry_count",
    "entry_set_sha256", "quarantine_state", "recovery_state", "state_artifact_set_sha256",
    "worker_artifact_sha256", "worker_version", "worker_slot", "journal_artifact_sha256",
    "release_bom_sha256", "protected_policy_sha256", "routing_epoch", "intake_stopped",
    "worker_drained", "remaining_in_flight", "worker_receipt_wire_sha256",
    "journal_receipt_sha256", "journal_receipt", "issued_at",
    "expires_at", "canonicalization", "signature_key_id", "signature_algorithm",
    "statement_sha256", "signature"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_id": {"const": "edge.journal.drain.attestation/v1"},
    "producer_module": {"const": "edge-local-journal"},
    "request_producer_module": {"const": "windows-edge-supervisor"},
    "soul_id": {"type": "string", "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": "string", "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": "string", "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"$ref": "#/$defs/exact_utc"},
    "privacy_class": {"const": "internal"},
    "request_id": {"$ref": "#/$defs/request_id"},
    "drain_id": {"$ref": "#/$defs/drain_id"},
    "command_id": {"$ref": "#/$defs/drain_id"},
    "entry_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$(?![\\s\\S])"},
    "entry_type": {"const": "WORKER_DRAINED"},
    "entry_sequence": {"$ref": "#/$defs/positive_int64"},
    "entry_checksum": {"$ref": "#/$defs/sha256"},
    "entry_payload_sha256": {"$ref": "#/$defs/sha256"},
    "journal_id": {"$ref": "#/$defs/journal_id"},
    "journal_file_sha256": {"$ref": "#/$defs/sha256"},
    "journal_file_identity_sha256": {"$ref": "#/$defs/sha256"},
    "journal_head_sequence": {"$ref": "#/$defs/positive_int64"},
    "journal_head_checksum": {"$ref": "#/$defs/sha256"},
    "checksum_encoding": {"const": "dps.length-prefixed-utf8/v1"},
    "range_start_sequence": {"$ref": "#/$defs/positive_int64"},
    "range_end_sequence": {"$ref": "#/$defs/positive_int64"},
    "range_entry_count": {"$ref": "#/$defs/positive_int64"},
    "entry_set_sha256": {"$ref": "#/$defs/sha256"},
    "quarantine_state": {"enum": ["CLEAR", "RELEASED"]},
    "recovery_state": {"enum": ["CLEAN", "CRASH_TAIL_ISOLATED"]},
    "state_artifact_set_sha256": {"$ref": "#/$defs/sha256"},
    "worker_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "worker_version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$(?![\\s\\S])"},
    "worker_slot": {"enum": ["A", "B"]},
    "journal_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "release_bom_sha256": {"$ref": "#/$defs/sha256"},
    "protected_policy_sha256": {"$ref": "#/$defs/sha256"},
    "routing_epoch": {"$ref": "#/$defs/nonnegative_int64"},
    "intake_stopped": {"const": true},
    "worker_drained": {"const": true},
    "remaining_in_flight": {"const": 0},
    "worker_receipt_wire_sha256": {"$ref": "#/$defs/sha256"},
    "journal_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "journal_receipt": {"$ref": "#/$defs/journal_receipt"},
    "issued_at": {"$ref": "#/$defs/exact_utc"},
    "expires_at": {"$ref": "#/$defs/exact_utc"},
    "canonicalization": {"const": "dps.utf8-byte-length-framing/v1"},
    "signature_key_id": {"$ref": "#/$defs/key_id"},
    "signature_algorithm": {"const": "RSA_PSS_SHA256"},
    "statement_sha256": {"$ref": "#/$defs/sha256"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "key_id": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256_[0-9a-f]{64}$(?![\\s\\S])"},
    "signature": {"type": "string", "minLength": 344, "maxLength": 2048, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])"},
    "exact_utc": {"type": "string", "format": "date-time", "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{7}\\+00:00$(?![\\s\\S])"},
    "positive_int64": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "nonnegative_int64": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "soul_id": {"type": "string", "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": "string", "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": "string", "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "request_id": {"type": "string", "pattern": "^drainreq_[a-f0-9]{64}$(?![\\s\\S])"},
    "drain_id": {"type": "string", "pattern": "^drain-[a-f0-9]{64}$(?![\\s\\S])"},
    "journal_id": {"type": "string", "pattern": "^journal_[a-f0-9]{64}$(?![\\s\\S])"},
    "journal_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "contract_id", "producer_module", "request_producer_module",
        "soul_id", "device_binding_id", "platform_account_id", "trace_id", "idempotency_key",
        "occurred_at", "privacy_class", "command_id", "entry_id", "entry_type",
        "payload_sha256", "sequence", "previous_checksum", "entry_checksum", "durable", "duplicate"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "contract_id": {"const": "edge.journal.receipt/v1"},
        "producer_module": {"const": "edge-local-journal"},
        "request_producer_module": {"const": "windows-edge-worker"},
        "soul_id": {"type": "string", "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
        "device_binding_id": {"type": "string", "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
        "platform_account_id": {"type": "string", "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
        "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
        "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
        "occurred_at": {"$ref": "#/$defs/exact_utc"},
        "privacy_class": {"const": "internal"},
        "command_id": {"$ref": "#/$defs/drain_id"},
        "entry_id": {"type": "string", "pattern": "^worker-drain-[a-f0-9]{64}$(?![\\s\\S])"},
        "entry_type": {"const": "WORKER_DRAINED"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "sequence": {"$ref": "#/$defs/positive_int64"},
        "previous_checksum": {"$ref": "#/$defs/sha256"},
        "entry_checksum": {"$ref": "#/$defs/sha256"},
        "durable": {"const": true},
        "duplicate": {"type": "boolean"}
      }
    }
  }
}
