<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Dps.EdgeLocalJournal.Contracts</AssemblyName>
    <RootNamespace>Dps.EdgeLocalJournal</RootNamespace>
    <PackageId>Dps.EdgeLocalJournal.Contracts</PackageId>
    <Version>0.2.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DefineConstants>$(DefineConstants);EDGE_LOCAL_JOURNAL_CONTRACTS</DefineConstants>
