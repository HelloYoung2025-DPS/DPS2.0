    <None Include="../edge.journal.receipt.v1.corpus.json" Pack="true" PackagePath="contracts" />
    <None Include="../edge.journal.drain.attestation.v1.schema.json" Pack="true" PackagePath="contracts" />
    <None Include="../edge.journal.drain.attestation.v1.auth.json" Pack="true" PackagePath="contracts" />
    <None Include="../edge.journal.drain.attestation.v1.corpus.json" Pack="true" PackagePath="contracts" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
