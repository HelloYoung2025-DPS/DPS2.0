{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/binding.composition.attestation.v1.schema.json",
  "title": "binding.composition.attestation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "producer_module", "soul_id", "device_binding_id", "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class", "root_key_id", "release_bom_sha256", "generation", "issued_at", "expires_at", "binding_instance_configuration_sha256", "binding_instance_trust_epoch", "binding_artifact_sha256", "binding_contracts_artifact_sha256", "composition_host_artifact_sha256", "device_registry_instance_configuration_sha256", "device_registry_instance_trust_epoch", "device_registry_artifact_sha256", "device_registry_contracts_artifact_sha256", "platform_account_registry_instance_configuration_sha256", "platform_account_registry_instance_trust_epoch", "platform_account_registry_artifact_sha256", "platform_account_registry_contracts_artifact_sha256", "signature_base64"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "binding.composition.attestation/v1"},
    "producer_module": {"const": "binding"},
    "soul_id": {"type": ["string", "null"], "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])", "const": null},
    "device_binding_id": {"type": ["string", "null"], "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])", "const": null},
    "platform_account_id": {"type": ["string", "null"], "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])", "const": null},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time", "pattern": "^(?!0000-)\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,7})?(?:Z|\\+00:00)$(?![\\s\\S])"},
    "privacy_class": {"const": "internal"},
    "root_key_id": {"const": "dps-binding-composition-root-2026-07"},
    "release_bom_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "issued_at": {"type": "string", "format": "date-time", "pattern": "^(?!0000-)\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,7})?(?:Z|\\+00:00)$(?![\\s\\S])"},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "^(?!0000-)\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,7})?(?:Z|\\+00:00)$(?![\\s\\S])"},
    "binding_instance_configuration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "binding_instance_trust_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "binding_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "binding_contracts_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "composition_host_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "device_registry_instance_configuration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "device_registry_instance_trust_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "device_registry_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "device_registry_contracts_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "platform_account_registry_instance_configuration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "platform_account_registry_instance_trust_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "platform_account_registry_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "platform_account_registry_contracts_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "signature_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$(?![\\s\\S])"}
  }
}
