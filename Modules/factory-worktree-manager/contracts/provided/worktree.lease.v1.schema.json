{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/worktree.lease.v1.schema.json",
  "title": "worktree.lease/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "producer_module", "soul_id", "device_binding_id",
    "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class",
    "lease_id", "plan_id", "holder_identity", "lock_keys", "lock_tokens", "fencing_token",
    "acquired_at", "expires_at", "status"
  ],
  "properties": {
    "schema_version": {"const": "dps.worktree-lease/v1"},
    "contract_id": {"const": "worktree.lease/v1"},
    "producer_module": {"const": "factory-worktree-manager"},
    "soul_id": {"type": ["string", "null"], "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": ["string", "null"], "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": ["string", "null"], "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "privacy_class": {"const": "internal"},
    "lease_id": {"type": "string", "pattern": "^lease:[0-9a-f]{32}$(?![\\s\\S])"},
    "plan_id": {"type": "string", "pattern": "^worktree:[0-9a-f]{32}$(?![\\s\\S])"},
    "holder_identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$(?![\\s\\S])"},
    "lock_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 512}},
    "lock_tokens": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
    "fencing_token": {"type": "integer", "minimum": 1},
    "acquired_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ACTIVE", "REVOKED", "EXPIRED"]}
  }
}
