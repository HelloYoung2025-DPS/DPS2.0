{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/worktree.plan.v1.schema.json",
  "title": "worktree.plan/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "producer_module", "soul_id", "device_binding_id",
    "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class",
    "plan_id", "change_plan_id", "instruction_receipt_id", "baseline_commit",
    "entries", "contract_worktree", "trusted_policy_sha256"
  ],
  "properties": {
    "schema_version": {"const": "dps.worktree-plan/v1"},
    "contract_id": {"const": "worktree.plan/v1"},
    "producer_module": {"const": "factory-worktree-manager"},
    "soul_id": {"type": ["string", "null"], "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": ["string", "null"], "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": ["string", "null"], "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "privacy_class": {"const": "internal"},
    "plan_id": {"type": "string", "pattern": "^worktree:[0-9a-f]{32}$(?![\\s\\S])"},
    "change_plan_id": {"type": "string", "pattern": "^change:[0-9a-f]{32}$(?![\\s\\S])"},
    "instruction_receipt_id": {"type": "string", "pattern": "^instruction:[0-9a-f]{32}$(?![\\s\\S])"},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "contract_worktree": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/contract_entry"}]},
    "trusted_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"}
  },
  "anyOf": [
    {"properties": {"entries": {"minItems": 1}}},
    {"properties": {"contract_worktree": {"$ref": "#/$defs/contract_entry"}}}
  ],
  "$defs": {
    "module_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])"},
    "repo_path": {"type": "string", "pattern": "^(?!/)(?!.*\\s$(?![\\s\\S]))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.[^/]+(?:/|$)).+$(?![\\s\\S])"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "entry": {"type": "object", "additionalProperties": false, "required": ["module_id", "writer_identity", "owned_paths", "worktree_ref", "depends_on", "lease_keys"], "properties": {
      "module_id": {"$ref": "#/$defs/module_id"},
      "writer_identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$(?![\\s\\S])"},
      "owned_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repo_path"}},
      "worktree_ref": {"type": "string", "pattern": "^factory-worktree:[a-z0-9-]+:[0-9a-f]{16}$(?![\\s\\S])"},
      "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/module_id"}},
      "lease_keys": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 512}}
    }},
    "contract_entry": {"type": "object", "additionalProperties": false, "required": ["writer_identity", "contract_ids", "owned_paths", "worktree_ref", "lease_keys"], "properties": {
      "writer_identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$(?![\\s\\S])"},
      "contract_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+)+$(?![\\s\\S])"}},
      "owned_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repo_path"}},
      "worktree_ref": {"type": "string", "pattern": "^factory-contract-worktree:[0-9a-f]{16}$(?![\\s\\S])"},
      "lease_keys": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 512}}
    }}
  }
}
