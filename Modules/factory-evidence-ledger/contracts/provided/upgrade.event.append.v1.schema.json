{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/upgrade.event.append.v1.schema.json",
  "title": "upgrade.event.append/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "producer_module", "soul_id", "device_binding_id",
    "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class",
    "stream_id", "expected_sequence", "event_type", "payload", "payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "upgrade.event.append/v1"},
    "producer_module": {"enum": ["factory-release-controller", "factory-rollback-controller"]},
    "soul_id": {"type": ["string", "null"], "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": ["string", "null"], "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": ["string", "null"], "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "privacy_class": {"const": "internal"},
    "stream_id": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$(?![\\s\\S])"},
    "expected_sequence": {"type": "integer", "minimum": 0},
    "event_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$(?![\\s\\S])"},
    "payload": {"type": "object"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"}
  }
}
