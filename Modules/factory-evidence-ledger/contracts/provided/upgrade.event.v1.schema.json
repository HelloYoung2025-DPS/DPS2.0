{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/upgrade.event.v1.schema.json",
  "title": "upgrade.event/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "producer_module", "soul_id", "device_binding_id",
    "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class",
    "event_id", "stream_id", "sequence", "event_type", "source_module", "payload",
    "payload_sha256", "previous_event_sha256", "event_sha256", "append_status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "upgrade.event/v1"},
    "producer_module": {"const": "factory-evidence-ledger"},
    "soul_id": {"type": ["string", "null"], "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": ["string", "null"], "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": ["string", "null"], "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "privacy_class": {"const": "internal"},
    "event_id": {"type": "string", "pattern": "^event-[0-9a-f]{32}$(?![\\s\\S])"},
    "stream_id": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$(?![\\s\\S])"},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$(?![\\s\\S])"},
    "source_module": {"enum": ["factory-release-controller", "factory-rollback-controller"]},
    "payload": {"type": "object"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "previous_event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "append_status": {"enum": ["APPENDED", "IDEMPOTENT_REPLAY"]}
  }
}
