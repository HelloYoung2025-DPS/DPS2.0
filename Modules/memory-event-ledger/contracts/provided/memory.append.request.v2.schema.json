{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/memory.append.request.v2.schema.json",
  "title": "memory.append.request/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "producer_module", "event_id", "soul_id", "device_binding_id", "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class", "signed_receipt_canonical_base64", "interest_signals"],
  "properties": {
    "schema_version": {"const": "2.0.0"}, "contract_id": {"const": "memory.append.request/v2"}, "producer_module": {"const": "control-plane-host"},
    "event_id": {"type": "string", "format": "uuid", "description": "MUST equal command_id inside signed_receipt_canonical_base64; preparation fails closed otherwise."}, "soul_id": {"type": "string", "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": "string", "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"}, "platform_account_id": {"type": "string", "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"}, "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time", "pattern": "Z$(?![\\s\\S])"}, "privacy_class": {"const": "personal"},
    "signed_receipt_canonical_base64": {"type": "string", "minLength": 4, "maxLength": 43692, "contentEncoding": "base64"},
    "interest_signals": {"type": "array", "maxItems": 32, "items": {"$ref": "memory.event.v2.schema.json#/$defs/signal"}}
  }
}
