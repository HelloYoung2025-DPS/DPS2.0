{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/memory.event.v2.schema.json",
  "title": "memory.event/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "producer_module", "event_id", "soul_id", "device_binding_id", "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class", "event_type", "observation", "identity_authority", "result_authority"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "contract_id": {"const": "memory.event/v2"},
    "producer_module": {"const": "memory-event-ledger"},
    "event_id": {"type": "string", "format": "uuid", "description": "MUST equal observation.command_id; the runtime and PostgreSQL gate enforce this cross-field invariant."},
    "soul_id": {"type": "string", "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": "string", "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": "string", "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time", "pattern": "Z$(?![\\s\\S])"},
    "privacy_class": {"const": "personal"},
    "event_type": {"const": "content.observed"},
    "observation": {"$ref": "#/$defs/observation"},
    "identity_authority": {"$ref": "#/$defs/identity_authority"},
    "result_authority": {"$ref": "#/$defs/result_authority"}
  },
  "$defs": {
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$(?![\\s\\S])"},
    "signal": {
      "type": "object", "additionalProperties": false,
      "required": ["topic", "confidence", "evidence_sha256"],
      "properties": {
        "topic": {"type": "string", "minLength": 1, "maxLength": 128},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["content_digest", "signals_digest", "signed_receipt_sha256", "receipt_id", "command_id", "interest_signals"],
      "properties": {
        "content_digest": {"$ref": "#/$defs/sha256"},
        "signals_digest": {"$ref": "#/$defs/sha256"},
        "signed_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_id": {"type": "string", "format": "uuid"},
        "command_id": {"type": "string", "format": "uuid", "description": "Signed command identity and the sole accepted event_id for this observation."},
        "interest_signals": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/signal"}}
      }
    },
    "identity_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["resolution_sha256", "resolution_revision", "issuer", "audience", "key_role", "key_id", "trust_epoch", "revocation_epoch", "issued_at", "expires_at"],
      "properties": {
        "resolution_sha256": {"$ref": "#/$defs/sha256"}, "resolution_revision": {"type": "integer", "minimum": 1},
        "issuer": {"const": "soul-registry"}, "audience": {"const": "memory-event-ledger"}, "key_role": {"const": "soul-resolution-current"},
        "key_id": {"$ref": "#/$defs/key_id"}, "trust_epoch": {"type": "integer", "minimum": 1}, "revocation_epoch": {"type": "integer", "minimum": 0},
        "issued_at": {"type": "string", "format": "date-time", "pattern": "Z$(?![\\s\\S])"}, "expires_at": {"type": "string", "format": "date-time", "pattern": "Z$(?![\\s\\S])"}
      }
    },
    "result_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["issuer", "audience", "key_role", "key_id", "trust_epoch", "revocation_epoch", "issued_at", "expires_at"],
      "properties": {
        "issuer": {"const": "executor-gateway"}, "audience": {"const": "memory-event-ledger"}, "key_role": {"const": "verified-observation-receipt"},
        "key_id": {"$ref": "#/$defs/key_id"}, "trust_epoch": {"type": "integer", "minimum": 1}, "revocation_epoch": {"type": "integer", "minimum": 0},
        "issued_at": {"type": "string", "format": "date-time", "pattern": "Z$(?![\\s\\S])"}, "expires_at": {"type": "string", "format": "date-time", "pattern": "Z$(?![\\s\\S])"}
      }
    }
  }
}
