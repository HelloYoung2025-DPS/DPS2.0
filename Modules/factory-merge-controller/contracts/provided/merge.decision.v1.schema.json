{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/merge.decision.v1.schema.json",
  "title": "merge.decision/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "producer_module", "soul_id",
    "device_binding_id", "platform_account_id", "trace_id",
    "idempotency_key", "occurred_at", "privacy_class", "decision_id",
    "merge_request_id", "integration_commit", "outcome", "reasons",
    "evidence_ids", "decided_by", "verification_scope",
    "trusted_policy_sha256", "runner_attestation_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "merge.decision/v1"},
    "producer_module": {"const": "factory-merge-controller"},
    "soul_id": {"type": ["string", "null"], "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": ["string", "null"], "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": ["string", "null"], "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "privacy_class": {"const": "internal"},
    "decision_id": {"type": "string", "pattern": "^merge-[0-9a-f]{32}$(?![\\s\\S])"},
    "merge_request_id": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$(?![\\s\\S])"},
    "integration_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"},
    "outcome": {"enum": ["APPROVED", "REJECTED"]},
    "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$(?![\\s\\S])"}},
    "decided_by": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$(?![\\s\\S])"},
    "verification_scope": {"const": "MERGE_HEAD_ONLY"},
    "trusted_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "runner_attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "APPROVED"}}},
      "then": {"properties": {"reasons": {"maxItems": 0}, "evidence_ids": {"minItems": 1}}}
    }
  ]
}
