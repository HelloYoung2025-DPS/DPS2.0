{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/merge.request.v1.schema.json",
  "title": "merge.request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "producer_module", "soul_id",
    "device_binding_id", "platform_account_id", "trace_id",
    "idempotency_key", "occurred_at", "privacy_class", "merge_request_id",
    "integration_commit", "branch_heads", "changed_paths", "evidence",
    "instruction_receipts", "current_diff_fingerprint", "conflicts",
    "trusted_policy_sha256", "runner_attestation"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "merge.request/v1"},
    "producer_module": {"const": "factory-trusted-runner"},
    "soul_id": {"type": ["string", "null"], "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": ["string", "null"], "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": ["string", "null"], "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "privacy_class": {"const": "internal"},
    "merge_request_id": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$(?![\\s\\S])"},
    "integration_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"},
    "branch_heads": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["module_id", "commit"],
        "properties": {
          "module_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"}
        }
      }
    },
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["basis", "result"],
        "properties": {
          "basis": {"enum": ["merge-head", "branch-head"]},
          "result": {"$ref": "https://dps.local/contracts/trusted.test.result.v1.schema.json"}
        }
      }
    },
    "instruction_receipts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["receipt_id", "status", "diff_fingerprint", "receipt_sha256"],
        "properties": {
          "receipt_id": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$(?![\\s\\S])"},
          "status": {"enum": ["BOUND", "STALE"]},
          "diff_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
          "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"}
        }
      }
    },
    "current_diff_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "conflicts": {
      "type": "object", "additionalProperties": false,
      "required": ["merge", "path_ownership", "contract_ownership"],
      "properties": {
        "merge": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "path_ownership": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "contract_ownership": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "trusted_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "runner_attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "signer_identity", "payload_sha256", "signature_value"],
      "properties": {
        "algorithm": {"const": "rsa-pss-sha256"},
        "key_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$(?![\\s\\S])"},
        "signer_identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$(?![\\s\\S])"},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
        "signature_value": {"type": "string", "minLength": 64}
      }
    }
  }
}
