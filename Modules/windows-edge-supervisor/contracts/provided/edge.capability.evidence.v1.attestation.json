      "evidence_log_file_identity_sha256",
      "connection_continuity_seconds",
      "connection_drops",
      "ab_switch_count",
      "soak_seconds"
    ]
  },
  "raw_evidence_sha256": "lowercase SHA-256 of the exact statement bytes",
  "verification_rule": "derive attestation truth by verifying the signature against the externally process-bound capability-only trust-store fingerprint, require that key role to be disjoint from artifact, bridge-server, Supervisor-drain, Worker-drain and Journal keys, then require exact host, Release BOM, protected policy, worker artifact/version/slot, Zenno PID/start time, protected bridge-server key, independent append-only evidence-log count/head/file identity, continuity, switch count, soak duration, and bounded validity/freshness matches; expiry equality is expired; no serialized attestation_verified field exists; the current runtime additionally returns WAITING_EXTERNAL while worker-launch-runtime-abi-unavailable is present"
}
