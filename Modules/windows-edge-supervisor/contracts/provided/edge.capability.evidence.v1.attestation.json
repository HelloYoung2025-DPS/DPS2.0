  "signature": {
    "algorithm": "RSA_PSS_SHA256",
    "rsa_padding": "PSS",
    "hash_algorithm": "SHA-256",
    "encoding": "canonical Base64"
  },
  "key_id": {
    "input": "DER-encoded X.509 SubjectPublicKeyInfo",
    "hash_algorithm": "SHA-256",
    "encoding": "sha256_<64 lowercase hex characters>"
  },
  "statement": {
    "domain": "dps.windows-edge-capability-evidence-attestation/v1",
    "prefix": "UTF-8 domain followed by one LF",
    "field_framing": {
      "present": "UTF-8-byte-length + ':' + exact-value + ';'",
      "null": "-1:;",
      "integer": "invariant base-10 string",
      "boolean": ["false", "true"],
      "unicode_normalization": "NONE",
      "invalid_unicode": "REJECT"
    },
    "fields": [
      "schema_version",
      "contract_id",
      "producer_module",
      "soul_id",
      "device_binding_id",
      "platform_account_id",
