      "worker_artifact_sha256",
      "worker_version",
      "worker_slot",
      "issued_at",
      "not_before",
      "expires_at",
      "evidence_kind",
      "is_windows",
      "powershell_version",
      "zennodroid_version",
      "zennodroid_pid_before",
      "zennodroid_pid_after",
      "zennodroid_started_at_before",
      "zennodroid_started_at_after",
      "dotnet_framework_version",
      "csharp_version",
      "codedom_supported",
      "gac_supported",
      "dll_load_supported",
      "adb_version",
