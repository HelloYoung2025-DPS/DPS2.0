{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/edge.capability.evidence.v1.schema.json",
  "title": "Windows Edge and ZennoDroid capability evidence v1",
  "x-dps-attestation-spec": "edge.capability.evidence.v1.attestation.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "producer_module",
    "soul_id",
    "device_binding_id",
    "platform_account_id",
    "trace_id",
    "idempotency_key",
    "occurred_at",
    "privacy_class",
    "status",
    "requested_level",
    "verification_claim",
    "evidence_kind",
    "raw_evidence_sha256",
    "attestation_key_id",
    "attestation_algorithm",
    "attestation_signature",
    "host_id",
    "release_bom_sha256",
    "protected_policy_sha256",
    "worker_artifact_sha256",
    "worker_version",
    "worker_slot",
    "issued_at",
    "not_before",
    "expires_at",
    "is_windows",
    "powershell_version",
    "zennodroid_version",
    "zennodroid_pid_before",
    "zennodroid_pid_after",
    "zennodroid_started_at_before",
    "zennodroid_started_at_after",
    "dotnet_framework_version",
    "csharp_version",
    "codedom_supported",
    "gac_supported",
    "dll_load_supported",
    "adb_version",
    "authorized_device_count",
    "bridge_abi",
    "loopback_port",
    "timeout_ms",
    "error_semantics",
    "peer_auth_mode",
    "peer_auth_key_id",
    "peer_auth_algorithm",
    "evidence_log_entry_count",
    "evidence_log_head_sha256",
    "evidence_log_file_identity_sha256",
    "connection_continuity_seconds",
    "connection_drops",
    "ab_switch_count",
    "soak_seconds",
    "missing"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_id": {"const": "edge.capability.evidence/v1"},
    "producer_module": {"const": "windows-edge-supervisor"},
    "soul_id": {"type": "string", "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": "string", "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": "string", "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time", "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|\\+00:00)$(?![\\s\\S])"},
    "privacy_class": {"const": "internal"},
    "status": {"enum": ["PASS", "FAIL", "WAITING_EXTERNAL"]},
    "requested_level": {"const": "WINDOWS_VERIFIED"},
    "verification_claim": {"type": ["string", "null"], "enum": ["WINDOWS_VERIFIED", null]},
    "evidence_kind": {"enum": ["UNATTESTED_LOCAL_PROBE", "SIMULATION", "REAL_WINDOWS_ATTESTED"]},
    "raw_evidence_sha256": {"type": ["string", "null"], "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "attestation_key_id": {"type": ["string", "null"], "minLength": 71, "maxLength": 71, "pattern": "^sha256_[a-f0-9]{64}$(?![\\s\\S])"},
    "attestation_algorithm": {"type": ["string", "null"], "enum": ["RSA_PSS_SHA256", null]},
    "attestation_signature": {"type": ["string", "null"], "minLength": 64, "maxLength": 2048, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])"},
    "host_id": {"type": "string", "pattern": "^host_[a-f0-9]{64}$(?![\\s\\S])"},
    "release_bom_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "protected_policy_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "worker_artifact_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "worker_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "worker_slot": {"enum": ["A", "B"]},
    "issued_at": {"type": "string", "format": "date-time", "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|\\+00:00)$(?![\\s\\S])"},
    "not_before": {"type": "string", "format": "date-time", "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|\\+00:00)$(?![\\s\\S])"},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|\\+00:00)$(?![\\s\\S])"},
    "is_windows": {"type": "boolean"},
    "powershell_version": {"type": ["string", "null"], "enum": ["7.6.2", null]},
    "zennodroid_version": {"type": ["string", "null"]},
    "zennodroid_pid_before": {"type": ["integer", "null"], "minimum": 1, "maximum": 2147483647},
    "zennodroid_pid_after": {"type": ["integer", "null"], "minimum": 1, "maximum": 2147483647},
    "zennodroid_started_at_before": {"type": ["string", "null"], "format": "date-time", "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|\\+00:00)$(?![\\s\\S])"},
    "zennodroid_started_at_after": {"type": ["string", "null"], "format": "date-time", "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|\\+00:00)$(?![\\s\\S])"},
    "dotnet_framework_version": {"type": ["string", "null"]},
    "csharp_version": {"type": ["string", "null"]},
    "codedom_supported": {"type": ["boolean", "null"]},
    "gac_supported": {"type": ["boolean", "null"]},
    "dll_load_supported": {"type": ["boolean", "null"]},
    "adb_version": {"type": ["string", "null"], "enum": ["37.0.0-14910828", null]},
    "authorized_device_count": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "bridge_abi": {"type": ["string", "null"], "enum": ["edge.bridge.exchange/v1", null]},
    "loopback_port": {"type": ["integer", "null"], "enum": [28741, null]},
    "timeout_ms": {"type": ["integer", "null"], "enum": [15000, null]},
    "error_semantics": {"type": ["string", "null"], "enum": ["fail-closed-unknown-outcome-no-implicit-retry/v1", null]},
    "peer_auth_mode": {"type": ["string", "null"], "enum": ["WINDOWS_IDENTITY_AND_PINNED_RSA", null]},
    "peer_auth_key_id": {"type": ["string", "null"], "minLength": 71, "maxLength": 71, "pattern": "^sha256_[a-f0-9]{64}$(?![\\s\\S])"},
    "peer_auth_algorithm": {"type": ["string", "null"], "enum": ["RSA_PKCS1_SHA256", null]},
    "evidence_log_entry_count": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "evidence_log_head_sha256": {"type": ["string", "null"], "minLength": 64, "maxLength": 64, "pattern": "^(?!0{64}$)[0-9a-f]{64}$(?![\\s\\S])"},
    "evidence_log_file_identity_sha256": {"type": ["string", "null"], "minLength": 64, "maxLength": 64, "pattern": "^(?!0{64}$)[0-9a-f]{64}$(?![\\s\\S])"},
    "connection_continuity_seconds": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "connection_drops": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "ab_switch_count": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "soak_seconds": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "missing": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
      "then": {
        "properties": {
          "verification_claim": {"const": "WINDOWS_VERIFIED"},
          "evidence_kind": {"const": "REAL_WINDOWS_ATTESTED"},
          "raw_evidence_sha256": {"type": "string"},
          "attestation_key_id": {"type": "string"},
          "attestation_algorithm": {"const": "RSA_PSS_SHA256"},
          "attestation_signature": {"type": "string"},
          "host_id": {"type": "string"},
          "release_bom_sha256": {"type": "string"},
          "protected_policy_sha256": {"type": "string"},
          "worker_artifact_sha256": {"type": "string"},
          "worker_version": {"type": "string", "minLength": 1},
          "worker_slot": {"enum": ["A", "B"]},
          "issued_at": {"type": "string"},
          "not_before": {"type": "string"},
          "expires_at": {"type": "string"},
          "is_windows": {"const": true},
          "powershell_version": {"const": "7.6.2"},
          "zennodroid_version": {"type": "string", "minLength": 1},
          "zennodroid_pid_before": {"type": "integer"},
          "zennodroid_pid_after": {"type": "integer"},
          "zennodroid_started_at_before": {"type": "string"},
          "zennodroid_started_at_after": {"type": "string"},
          "dotnet_framework_version": {"type": "string", "minLength": 1},
          "csharp_version": {"type": "string", "minLength": 1},
          "codedom_supported": {"const": true},
          "gac_supported": {"const": true},
          "dll_load_supported": {"const": true},
          "adb_version": {"const": "37.0.0-14910828"},
          "authorized_device_count": {"minimum": 1},
          "bridge_abi": {"type": "string", "minLength": 1},
          "loopback_port": {"type": "integer"},
          "timeout_ms": {"type": "integer"},
          "error_semantics": {"type": "string", "minLength": 1},
          "peer_auth_mode": {"const": "WINDOWS_IDENTITY_AND_PINNED_RSA"},
          "peer_auth_key_id": {"type": "string"},
          "peer_auth_algorithm": {"const": "RSA_PKCS1_SHA256"},
          "evidence_log_entry_count": {"minimum": 100},
          "evidence_log_head_sha256": {"type": "string"},
          "evidence_log_file_identity_sha256": {"type": "string"},
          "connection_continuity_seconds": {"minimum": 86400},
          "connection_drops": {"const": 0},
          "ab_switch_count": {"minimum": 100},
          "soak_seconds": {"minimum": 86400},
          "missing": {"maxItems": 0}
        }
      },
      "else": {"properties": {"verification_claim": {"type": "null"}}}
    },
    {
      "if": {
        "properties": {"evidence_kind": {"enum": ["UNATTESTED_LOCAL_PROBE", "SIMULATION"]}},
        "required": ["evidence_kind"]
      },
      "then": {
        "properties": {
          "verification_claim": {"type": "null"},
          "raw_evidence_sha256": {"type": "null"},
          "attestation_key_id": {"type": "null"},
          "attestation_algorithm": {"type": "null"},
          "attestation_signature": {"type": "null"},
          "evidence_log_entry_count": {"const": 0},
          "evidence_log_head_sha256": {"type": "null"},
          "evidence_log_file_identity_sha256": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"evidence_kind": {"const": "REAL_WINDOWS_ATTESTED"}},
        "required": ["evidence_kind"]
      },
      "then": {
        "properties": {
          "raw_evidence_sha256": {"type": "string"},
          "attestation_key_id": {"type": "string"},
          "attestation_algorithm": {"const": "RSA_PSS_SHA256"},
          "attestation_signature": {"type": "string"},
          "evidence_log_entry_count": {"minimum": 100},
          "evidence_log_head_sha256": {"type": "string"},
          "evidence_log_file_identity_sha256": {"type": "string"}
        }
      }
    }
  ]
}
