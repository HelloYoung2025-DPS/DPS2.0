{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/edge.worker.drain.directive.v1.schema.json",
  "title": "Signed Windows Edge worker drain directive v1",
  "x-dps-auth-spec": "edge.worker.drain.directive.v1.auth.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "producer_module", "soul_id",
    "device_binding_id", "platform_account_id", "trace_id", "idempotency_key",
    "occurred_at", "privacy_class", "drain_id", "slot", "worker_version",
    "worker_artifact_sha256", "journal_artifact_sha256", "release_bom_sha256",
    "protected_policy_sha256", "routing_epoch", "issued_at", "not_before",
    "expires_at", "supervisor_key_id", "signature_algorithm", "signature"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_id": {"const": "edge.worker.drain.directive/v1"},
    "producer_module": {"const": "windows-edge-supervisor"},
    "soul_id": {"type": "string", "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": "string", "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": "string", "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"$ref": "#/$defs/utc"},
    "privacy_class": {"const": "internal"},
    "drain_id": {"type": "string", "pattern": "^drain-[a-f0-9]{64}$(?![\\s\\S])"},
    "slot": {"enum": ["A", "B"]},
    "worker_version": {
      "type": "string", "minLength": 1, "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$(?![\\s\\S])"
    },
    "worker_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "journal_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "release_bom_sha256": {"$ref": "#/$defs/sha256"},
    "protected_policy_sha256": {"$ref": "#/$defs/sha256"},
    "routing_epoch": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "issued_at": {"$ref": "#/$defs/utc"},
    "not_before": {"$ref": "#/$defs/utc"},
    "expires_at": {"$ref": "#/$defs/utc"},
    "supervisor_key_id": {"$ref": "#/$defs/key_id"},
    "signature_algorithm": {"const": "RSA_PSS_SHA256"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "sha256": {
      "type": "string", "minLength": 64, "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "key_id": {
      "type": "string", "minLength": 71, "maxLength": 71,
      "pattern": "^sha256_[0-9a-f]{64}$(?![\\s\\S])"
    },
    "signature": {
      "type": "string", "minLength": 64, "maxLength": 2048,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])"
    },
    "utc": {
      "type": "string", "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{7}\\+00:00$(?![\\s\\S])"
    }
  }
}
