{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/active.release.binding.v1.schema.json",
  "title": "active.release.binding/v1",
  "description": "Per-device active Release BOM runtime truth owned by control-plane-host: signed BOM digest, monotonic generation, opaque execution token, and active/previous/revoked status.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "producer_module", "device_binding_id", "release_bom_sha256", "generation", "execution_token", "status", "signer_identity", "signer_key_id", "bom_signature_sha256", "activated_at", "receipt_id"],
  "properties": {
    "schema_version": {"type": "string", "maxLength": 32, "pattern": "^1(?:\\.[0-9]+){0,2}$(?![\\s\\S])"},
    "contract_id": {"const": "active.release.binding/v1"},
    "producer_module": {"const": "control-plane-host"},
    "device_binding_id": {"type": "string", "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "release_bom_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "execution_token": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "status": {"enum": ["active", "previous", "revoked"]},
    "signer_identity": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9-]{1,63}$(?![\\s\\S])"},
    "signer_key_id": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9-]{1,63}$(?![\\s\\S])"},
    "bom_signature_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "activated_at": {"type": "string", "maxLength": 32, "format": "date-time", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{0,6}[1-9])?Z$(?![\\s\\S])"},
    "receipt_id": {"type": "string", "pattern": "^receipt_[a-f0-9]{32}$(?![\\s\\S])"}
  }
}
