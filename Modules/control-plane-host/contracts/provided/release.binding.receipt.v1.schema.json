{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/release.binding.receipt.v1.schema.json",
  "title": "release.binding.receipt/v1",
  "description": "Versioned receipt for active Release BOM activation, revocation, and rollback transitions. payload_sha256 is the lowercase hex SHA-256 over the canonical JSON of every receipt field except payload_sha256 itself, where canonical JSON is python json.dumps(value, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False) encoded as UTF-8 (the repository anchor_id canonicalization convention).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "producer_module", "receipt_kind", "device_binding_id", "from", "to", "sequence", "actor_identity", "occurred_at", "payload_sha256", "receipt_id"],
  "properties": {
    "schema_version": {"type": "string", "maxLength": 32, "pattern": "^1(?:\\.[0-9]+){0,2}$(?![\\s\\S])"},
    "contract_id": {"const": "release.binding.receipt/v1"},
    "producer_module": {"const": "control-plane-host"},
    "receipt_kind": {"enum": ["activation", "revocation", "rollback"]},
    "device_binding_id": {"type": "string", "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "from": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/endpoint"}]},
    "to": {"$ref": "#/$defs/endpoint"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "actor_identity": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9-]{1,63}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "maxLength": 32, "format": "date-time", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{0,6}[1-9])?Z$(?![\\s\\S])"},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "receipt_id": {"type": "string", "pattern": "^receipt_[a-f0-9]{32}$(?![\\s\\S])"}
  },
  "oneOf": [
    {
      "properties": {
        "receipt_kind": {"const": "activation"},
        "from": {"anyOf": [{"type": "null"}, {"properties": {"status": {"enum": ["previous", "revoked"]}}}]},
        "to": {"properties": {"status": {"const": "active"}}}
      }
    },
    {
      "properties": {
        "receipt_kind": {"const": "revocation"},
        "from": {"type": "object", "properties": {"status": {"const": "active"}}},
        "to": {"properties": {"status": {"const": "revoked"}}}
      }
    },
    {
      "properties": {
        "receipt_kind": {"const": "rollback"},
        "from": {"type": "object", "properties": {"status": {"const": "revoked"}}},
        "to": {"properties": {"status": {"const": "active"}}}
      }
    }
  ],
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_bom_sha256", "generation", "status"],
      "properties": {
        "release_bom_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
        "generation": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "status": {"enum": ["active", "previous", "revoked"]}
      }
    }
  }
}
