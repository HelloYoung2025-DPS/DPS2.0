{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/approval.submission.recovery.v1.schema.json",
  "title": "approval.submission.recovery/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "producer_module", "auth_scope", "authority_role", "recovery_id", "submission_attempt_id", "reconciliation_id", "reconciliation_sha256", "approval_id", "proposal_id", "command_id", "previous_lease_id", "previous_attempt", "next_submission_attempt_id", "next_lease_id", "next_attempt", "soul_id", "device_binding_id", "platform_account_id", "trace_id", "idempotency_key", "next_release_bom_sha256", "next_release_bom_generation", "next_execution_authorization_sha256", "next_native_request_binding_sha256", "human_approval_id", "occurred_at", "valid_until", "privacy_class", "signature_base64"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "approval.submission.recovery/v1"},
    "producer_module": {"const": "control-plane-host"},
    "auth_scope": {"const": "approval:submission:recover"},
    "authority_role": {"const": "human-release-approver"},
    "recovery_id": {"$ref": "#/$defs/uuid"},
    "submission_attempt_id": {"$ref": "#/$defs/uuid"},
    "reconciliation_id": {"$ref": "#/$defs/uuid"},
    "reconciliation_sha256": {"$ref": "#/$defs/sha256"},
    "approval_id": {"$ref": "#/$defs/uuid"},
    "proposal_id": {"$ref": "#/$defs/uuid"},
    "command_id": {"$ref": "#/$defs/uuid"},
    "previous_lease_id": {"$ref": "#/$defs/uuid"},
    "previous_attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "next_submission_attempt_id": {"$ref": "#/$defs/uuid"},
    "next_lease_id": {"$ref": "#/$defs/uuid"},
    "next_attempt": {"type": "integer", "minimum": 2, "maximum": 3},
    "soul_id": {"type": "string", "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": "string", "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": "string", "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "next_release_bom_sha256": {"$ref": "#/$defs/sha256"},
    "next_release_bom_generation": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "next_execution_authorization_sha256": {"$ref": "#/$defs/sha256"},
    "next_native_request_binding_sha256": {"$ref": "#/$defs/sha256"},
    "human_approval_id": {"type": "string", "pattern": "^human_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"$ref": "#/$defs/time"},
    "valid_until": {"$ref": "#/$defs/time"},
    "privacy_class": {"const": "internal"},
    "signature_base64": {"$ref": "#/$defs/signature"}
  },
  "allOf": [{"if": {"properties": {"previous_attempt": {"const": 1}}}, "then": {"properties": {"next_attempt": {"const": 2}}}}, {"if": {"properties": {"previous_attempt": {"const": 2}}}, "then": {"properties": {"next_attempt": {"const": 3}}}}],
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$(?![\\s\\S])"},
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "time": {"type": "string", "format": "date-time", "pattern": "^(?!0000-)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{0,6}[1-9])?Z$(?![\\s\\S])"},
    "signature": {"type": "string", "minLength": 88, "maxLength": 88, "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$(?![\\s\\S])"}
  }
}
