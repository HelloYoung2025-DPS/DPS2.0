{
  "schema_version": "dps.factory-fixed-adapter-profiles/v1",
  "status": "non-production-template",
  "required_profile_bindings": [
    "target_module",
    "operation",
    "complete_argv",
    "canonical_executable_sha256",
    "canonical_cwd",
    "cwd_tree_sha256",
    "external_file_sha256s",
    "fixed_non_secret_environment",
    "timeout_seconds",
    "non_root_service_identity",
    "system_owned_service_nonwritable_deployment",
    "no_follow_execution_file_identities",
    "bounded_stdout_stderr_bytes",
    "profile_sha256",
    "external_policy_sha256"
  ],
  "runtime_rules": [
    "shell_false",
    "no_inherited_environment",
    "no_secret_named_environment",
    "reverify_all_bindings_before_each_invoke",
    "recheck_file_identities_immediately_before_process_creation",
    "fail_closed_without_platform_immutable_launcher",
    "stream_output_and_kill_process_group_on_limit_or_timeout"
  ],
  "profiles": [
    ["factory-upgrade-intake", "validate-intent"],
    ["factory-instruction-resolver", "bind-instructions"],
    ["factory-instruction-resolver", "verify-baseline"],
    ["factory-impact-analyzer", "freeze-contract-plan"],
    ["factory-worktree-manager", "plan-module-worktrees"],
    ["factory-trusted-runner", "verify-implementation-ready"],
    ["factory-trusted-runner", "verify-changeset"],
    ["factory-trusted-runner", "security-privacy-review"],
    ["factory-trusted-runner", "reliability-review"],
    ["factory-trusted-runner", "windows-zenno-review"],
    ["factory-merge-controller", "verify-merge-head"],
    ["factory-artifact-builder", "build-candidate"],
    ["factory-evidence-ledger", "replay-audit"],
    ["factory-release-controller", "verify-signed-bom"],
    ["factory-release-controller", "run-shadow"],
    ["factory-release-controller", "run-canary"],
    ["factory-release-controller", "run-rolling"],
    ["factory-release-controller", "run-soak"],
    ["factory-release-controller", "complete-release"],
    ["factory-rollback-controller", "prepare-rollback"],
    ["factory-rollback-controller", "execute-rollback"]
  ]
}
