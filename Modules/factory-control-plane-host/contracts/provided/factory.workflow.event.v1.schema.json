{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/factory.workflow.event.v1.schema.json",
  "title": "factory.workflow.event/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "producer_module", "soul_id", "device_binding_id", "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class", "workflow_id", "sequence", "event_id", "event_type", "state", "fencing_token", "payload", "payload_sha256", "previous_event_sha256", "event_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "contract_id": {"const": "factory.workflow.event/v1"}, "producer_module": {"const": "factory-control-plane-host"},
    "soul_id": {"type": ["string", "null"], "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"}, "device_binding_id": {"type": ["string", "null"], "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"}, "platform_account_id": {"type": ["string", "null"], "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"}, "privacy_class": {"const": "internal"},
    "workflow_id": {"type": "string", "pattern": "^upgrade:[A-Za-z0-9][A-Za-z0-9._-]{7,119}$(?![\\s\\S])"}, "sequence": {"type": "integer", "minimum": 1}, "event_id": {"type": "string", "pattern": "^workflow-event:[0-9a-f]{32}$(?![\\s\\S])"},
    "event_type": {"enum": ["WORKFLOW_REQUESTED", "STAGE_SCHEDULED", "PHASE_COMPLETED", "STATE_TRANSITIONED", "EXTERNAL_FACT_BOUND", "WAITING_EXTERNAL", "ROLLBACK_REQUESTED", "WORKFLOW_QUARANTINED"]},
    "state": {"$ref": "#/$defs/state"}, "fencing_token": {"type": "integer", "minimum": 0}, "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "payload": {"type": "object"}, "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"}, "previous_event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"}, "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"}, "occurred_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"state": {"enum": ["REQUESTED", "SCOPE_RESOLVED", "INSTRUCTIONS_BOUND", "BASELINE_VERIFIED", "CONTRACT_FROZEN", "IMPLEMENTING", "CHANGESET_FROZEN", "CANDIDATE_BUILT", "CANDIDATE_VERIFIED", "BOM_SIGNED", "SHADOW", "CANARY", "ROLLING", "SOAKING", "COMPLETED", "STALE", "REWORKING", "WAITING_EXTERNAL", "QUARANTINED", "ROLLBACK_REQUIRED", "ROLLING_BACK", "ROLLED_BACK", "FAILED", "CANCELLED"]}}
}
