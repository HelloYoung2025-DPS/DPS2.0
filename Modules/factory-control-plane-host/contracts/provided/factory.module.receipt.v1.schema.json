{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/factory.module.receipt.v1.schema.json",
  "title": "factory.module.receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "producer_module", "soul_id", "device_binding_id", "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class", "workflow_id", "request_id", "stage_id", "target_module", "operation", "actor_identity", "actor_role", "fencing_token", "logical_request_sha256", "status", "mode", "evidence_kind", "verification_level", "simulation_only", "side_effect_count", "outputs", "attestation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "factory.module.receipt/v1"},
    "producer_module": {"const": "factory-control-plane-host"},
    "soul_id": {"type": ["string", "null"], "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": ["string", "null"], "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": ["string", "null"], "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "privacy_class": {"const": "internal"},
    "workflow_id": {"type": "string", "pattern": "^upgrade:[A-Za-z0-9][A-Za-z0-9._-]{7,119}$(?![\\s\\S])"},
    "request_id": {"type": "string", "pattern": "^call:[0-9a-f]{32}$(?![\\s\\S])"},
    "stage_id": {"type": "string", "pattern": "^stage:[0-9a-f]{32}$(?![\\s\\S])"},
    "target_module": {"enum": ["factory-upgrade-intake", "factory-instruction-resolver", "factory-impact-analyzer", "factory-worktree-manager", "factory-trusted-runner", "factory-merge-controller", "factory-artifact-builder", "factory-evidence-ledger", "factory-release-controller", "factory-rollback-controller"]},
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$(?![\\s\\S])"},
    "actor_identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$(?![\\s\\S])"},
    "actor_role": {"enum": ["impact-planner", "contract-architect", "module-implementer", "independent-test-agent", "security-privacy-adversary", "reliability-reviewer", "windows-zenno-reviewer", "evidence-auditor", "release-rollback-controller"]},
    "fencing_token": {"type": "integer", "minimum": 1},
    "logical_request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "status": {"enum": ["PASS", "FAIL", "STALE", "WAITING_EXTERNAL", "INFRA_ERROR", "QUARANTINED"]},
    "mode": {"enum": ["SIMULATION", "PRODUCTION"]},
    "evidence_kind": {"enum": ["SIMULATION", "REPOSITORY", "CONTRACT", "INTEGRATION", "WINDOWS", "DEVICE", "CANARY", "SCALE"]},
    "verification_level": {"enum": ["REPOSITORY_STATIC_VERIFIED", "CONTRACT_VERIFIED", "INTEGRATION_VERIFIED", "WINDOWS_VERIFIED", "DEVICE_VERIFIED", "CANARY_VERIFIED", "SCALE_VERIFIED"]},
    "simulation_only": {"type": "boolean"},
    "side_effect_count": {"type": "integer", "minimum": 0},
    "outputs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["contract_id", "producer_module", "payload_sha256", "payload"], "properties": {"contract_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+)+/v[1-9][0-9]*$(?![\\s\\S])"}, "producer_module": {"enum": ["factory-upgrade-intake", "factory-instruction-resolver", "factory-impact-analyzer", "factory-worktree-manager", "factory-trusted-runner", "factory-merge-controller", "factory-artifact-builder", "factory-evidence-ledger", "factory-release-controller", "factory-rollback-controller"]}, "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"}, "payload": {"type": "object"}}}},
    "occurred_at": {"type": "string", "format": "date-time"},
    "attestation": {"type": "object", "additionalProperties": false, "required": ["kind", "verifier_identity", "payload_sha256", "reference"], "properties": {"kind": {"enum": ["SIMULATION_ONLY", "EXTERNAL_VERIFIED"]}, "verifier_identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$(?![\\s\\S])"}, "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"}, "reference": {"type": "string", "pattern": "^[^\\s\\r\\n\\u0000][^\\r\\n\\u0000]{6,254}[^\\s\\r\\n\\u0000]$(?![\\s\\S])"}}}
  },
  "allOf": [
    {"if": {"properties": {"simulation_only": {"const": true}}, "required": ["simulation_only"]}, "then": {"properties": {"mode": {"const": "SIMULATION"}, "evidence_kind": {"const": "SIMULATION"}, "verification_level": {"const": "INTEGRATION_VERIFIED"}, "side_effect_count": {"const": 0}, "attestation": {"properties": {"kind": {"const": "SIMULATION_ONLY"}}}}}},
    {"if": {"properties": {"mode": {"const": "SIMULATION"}}, "required": ["mode"]}, "then": {"properties": {"simulation_only": {"const": true}, "evidence_kind": {"const": "SIMULATION"}, "verification_level": {"const": "INTEGRATION_VERIFIED"}, "side_effect_count": {"const": 0}, "attestation": {"properties": {"kind": {"const": "SIMULATION_ONLY"}}}}}},
    {"if": {"properties": {"mode": {"const": "PRODUCTION"}}, "required": ["mode"]}, "then": {"properties": {"simulation_only": {"const": false}, "evidence_kind": {"enum": ["REPOSITORY", "CONTRACT", "INTEGRATION", "WINDOWS", "DEVICE", "CANARY", "SCALE"]}, "attestation": {"properties": {"kind": {"const": "EXTERNAL_VERIFIED"}}}}}},
    {"if": {"properties": {"evidence_kind": {"const": "REPOSITORY"}}, "required": ["evidence_kind"]}, "then": {"properties": {"verification_level": {"const": "REPOSITORY_STATIC_VERIFIED"}}}},
    {"if": {"properties": {"evidence_kind": {"const": "CONTRACT"}}, "required": ["evidence_kind"]}, "then": {"properties": {"verification_level": {"const": "CONTRACT_VERIFIED"}}}},
    {"if": {"properties": {"evidence_kind": {"const": "INTEGRATION"}}, "required": ["evidence_kind"]}, "then": {"properties": {"verification_level": {"const": "INTEGRATION_VERIFIED"}}}},
    {"if": {"properties": {"evidence_kind": {"const": "WINDOWS"}}, "required": ["evidence_kind"]}, "then": {"properties": {"verification_level": {"const": "WINDOWS_VERIFIED"}}}},
    {"if": {"properties": {"evidence_kind": {"const": "DEVICE"}}, "required": ["evidence_kind"]}, "then": {"properties": {"verification_level": {"const": "DEVICE_VERIFIED"}}}},
    {"if": {"properties": {"evidence_kind": {"const": "CANARY"}}, "required": ["evidence_kind"]}, "then": {"properties": {"verification_level": {"const": "CANARY_VERIFIED"}}}},
    {"if": {"properties": {"evidence_kind": {"const": "SCALE"}}, "required": ["evidence_kind"]}, "then": {"properties": {"verification_level": {"const": "SCALE_VERIFIED"}}}},
    {"if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]}, "then": {"properties": {"outputs": {"minItems": 1}}}}
  ]
}
