{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/factory.workflow.status.v1.schema.json",
  "title": "factory.workflow.status/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "producer_module", "soul_id", "device_binding_id", "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class", "workflow_id", "request_sha256", "state", "sequence", "fencing_token", "mode", "risk_tier", "simulation_only", "production_authorized", "verification_ceiling", "role_binding_id", "pending_outbox", "receipt_ids", "waiting_reason", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "contract_id": {"const": "factory.workflow.status/v1"}, "producer_module": {"const": "factory-control-plane-host"},
    "soul_id": {"type": ["string", "null"], "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"}, "device_binding_id": {"type": ["string", "null"], "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"}, "platform_account_id": {"type": ["string", "null"], "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"}, "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"}, "occurred_at": {"type": "string", "format": "date-time"}, "privacy_class": {"const": "internal"},
    "workflow_id": {"type": "string", "pattern": "^upgrade:[A-Za-z0-9][A-Za-z0-9._-]{7,119}$(?![\\s\\S])"}, "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"}, "state": {"enum": ["REQUESTED", "SCOPE_RESOLVED", "INSTRUCTIONS_BOUND", "BASELINE_VERIFIED", "CONTRACT_FROZEN", "IMPLEMENTING", "CHANGESET_FROZEN", "CANDIDATE_BUILT", "CANDIDATE_VERIFIED", "BOM_SIGNED", "SHADOW", "CANARY", "ROLLING", "SOAKING", "COMPLETED", "STALE", "REWORKING", "WAITING_EXTERNAL", "QUARANTINED", "ROLLBACK_REQUIRED", "ROLLING_BACK", "ROLLED_BACK", "FAILED", "CANCELLED"]}, "sequence": {"type": "integer", "minimum": 1}, "fencing_token": {"type": "integer", "minimum": 0},
    "mode": {"enum": ["SIMULATION", "PRODUCTION"]}, "risk_tier": {"enum": ["R0", "R1", "R2", "R3"]}, "simulation_only": {"type": "boolean"}, "production_authorized": {"type": "boolean"},
    "verification_ceiling": {"enum": ["REPOSITORY_STATIC_VERIFIED", "CONTRACT_VERIFIED", "INTEGRATION_VERIFIED", "WINDOWS_VERIFIED", "DEVICE_VERIFIED", "CANARY_VERIFIED", "SCALE_VERIFIED"]},
    "role_binding_id": {"type": "string", "pattern": "^roles:[0-9a-f]{32}$(?![\\s\\S])"}, "pending_outbox": {"type": "integer", "minimum": 0}, "receipt_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^module-receipt:[0-9a-f]{32}$(?![\\s\\S])"}}, "waiting_reason": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_:-]{2,255}$(?![\\s\\S])"}, "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [{"if": {"properties": {"simulation_only": {"const": true}}, "required": ["simulation_only"]}, "then": {"properties": {"mode": {"const": "SIMULATION"}, "production_authorized": {"const": false}, "verification_ceiling": {"const": "INTEGRATION_VERIFIED"}}}}]
}
