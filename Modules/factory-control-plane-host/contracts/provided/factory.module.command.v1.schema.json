{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/factory.module.command.v1.schema.json",
  "title": "factory.module.command/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "producer_module", "soul_id", "device_binding_id", "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class", "workflow_id", "request_id", "stage_id", "target_module", "operation", "actor_identity", "actor_role", "fencing_token", "logical_request_sha256", "mode", "expected_output_contracts", "context_sha256", "context"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "factory.module.command/v1"},
    "producer_module": {"const": "factory-control-plane-host"},
    "soul_id": {"type": ["string", "null"], "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": ["string", "null"], "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": ["string", "null"], "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "privacy_class": {"const": "internal"},
    "workflow_id": {"type": "string", "pattern": "^upgrade:[A-Za-z0-9][A-Za-z0-9._-]{7,119}$(?![\\s\\S])"},
    "request_id": {"type": "string", "pattern": "^call:[0-9a-f]{32}$(?![\\s\\S])"},
    "stage_id": {"type": "string", "pattern": "^stage:[0-9a-f]{32}$(?![\\s\\S])"},
    "target_module": {"enum": ["factory-upgrade-intake", "factory-instruction-resolver", "factory-impact-analyzer", "factory-worktree-manager", "factory-trusted-runner", "factory-merge-controller", "factory-artifact-builder", "factory-evidence-ledger", "factory-release-controller", "factory-rollback-controller"]},
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$(?![\\s\\S])"},
    "actor_identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$(?![\\s\\S])"},
    "actor_role": {"enum": ["impact-planner", "contract-architect", "module-implementer", "independent-test-agent", "security-privacy-adversary", "reliability-reviewer", "windows-zenno-reviewer", "evidence-auditor", "release-rollback-controller"]},
    "fencing_token": {"type": "integer", "minimum": 1},
    "logical_request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "mode": {"enum": ["SIMULATION", "PRODUCTION"]},
    "expected_output_contracts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+)+/v[1-9][0-9]*$(?![\\s\\S])"}},
    "context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "context": {"type": "object"},
    "occurred_at": {"type": "string", "format": "date-time"}
  }
}
