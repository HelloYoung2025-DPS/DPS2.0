{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/factory.role.binding.v1.schema.json",
  "title": "factory.role.binding/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "producer_module", "soul_id", "device_binding_id", "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class", "workflow_id", "binding_id", "policy_sha256", "verifier_identity", "verified_at", "roles"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "factory.role.binding/v1"},
    "producer_module": {"const": "factory-control-plane-host"},
    "soul_id": {"type": ["string", "null"], "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": ["string", "null"], "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": ["string", "null"], "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "privacy_class": {"const": "internal"},
    "workflow_id": {"type": "string", "pattern": "^upgrade:[A-Za-z0-9][A-Za-z0-9._-]{7,119}$(?![\\s\\S])"},
    "binding_id": {"type": "string", "pattern": "^roles:[0-9a-f]{32}$(?![\\s\\S])"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "verifier_identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$(?![\\s\\S])"},
    "verified_at": {"type": "string", "format": "date-time"},
    "roles": {
      "type": "object", "additionalProperties": false,
      "required": ["impact-planner", "contract-architect", "module-implementer", "independent-test-agent", "security-privacy-adversary", "reliability-reviewer", "windows-zenno-reviewer", "evidence-auditor", "release-rollback-controller"],
      "properties": {
        "impact-planner": {"$ref": "#/$defs/identity"},
        "contract-architect": {"$ref": "#/$defs/identity"},
        "module-implementer": {"$ref": "#/$defs/identity"},
        "independent-test-agent": {"$ref": "#/$defs/identity"},
        "security-privacy-adversary": {"$ref": "#/$defs/identity"},
        "reliability-reviewer": {"$ref": "#/$defs/identity"},
        "windows-zenno-reviewer": {"$ref": "#/$defs/identity"},
        "evidence-auditor": {"$ref": "#/$defs/identity"},
        "release-rollback-controller": {"$ref": "#/$defs/identity"}
      }
    }
  },
  "$defs": {"identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$(?![\\s\\S])"}}
}
