{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/factory.workflow.request.v1.schema.json",
  "title": "factory.workflow.request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "producer_module", "soul_id", "device_binding_id", "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class", "workflow_id", "mode", "risk_tier", "baseline_commit", "target_modules", "requested_paths", "public_contract_changes", "external_context_ref"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "factory.workflow.request/v1"},
    "producer_module": {"const": "factory-control-plane-host"},
    "soul_id": {"type": ["string", "null"], "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": ["string", "null"], "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": ["string", "null"], "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "privacy_class": {"const": "internal"},
    "workflow_id": {"type": "string", "pattern": "^upgrade:[A-Za-z0-9][A-Za-z0-9._-]{7,119}$(?![\\s\\S])"},
    "mode": {"enum": ["SIMULATION", "PRODUCTION"]},
    "risk_tier": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"},
    "target_modules": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])"}},
    "requested_paths": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"type": "string", "maxLength": 512, "pattern": "^(?!/)(?!.*\\s$(?![\\s\\S]))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.[^/]+(?:/|$)).+$(?![\\s\\S])"}},
    "public_contract_changes": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+)+$(?![\\s\\S])"}},
    "external_context_ref": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$(?![\\s\\S])"}
  }
}
