{
  "schema_version": "dps.trusted-runner-policy/v1",
  "policy_id": "factory-runner-default-2026-07-14",
  "status": "non-production-template",
  "runner_identity": "factory-trusted-runner-service",
  "allowed_executables": ["python3.12"],
  "allowed_environment": ["HOME", "PATH", "PYTHONUTF8", "TMPDIR"],
  "maximum_output_bytes": 1048576,
  "roles": {
    "implementers": [
      "factory-module-implementer-1",
      "factory-module-implementer-2",
      "factory-module-implementer-3",
      "factory-module-implementer-4"
    ],
    "evidence_issuers": ["factory-trusted-runner-service"],
    "release_approvers": ["human-release-approver-1"]
  },
  "checks": [
    {
      "check_id": "factory-upgrade-intake.unit",
      "module_id": "factory-upgrade-intake",
      "argv": ["python3.12", "-m", "unittest", "discover", "-s", "Modules/factory-upgrade-intake/tests", "-p", "test_*.py"],
      "cwd": ".",
      "timeout_seconds": 120,
      "required": true,
      "success_marker": "OK",
      "forbidden_output_markers": ["FAILED", "SKIP", "skipped=", "PARTIAL", "NOT_RUN", "INFRA_ERROR"]
    },
