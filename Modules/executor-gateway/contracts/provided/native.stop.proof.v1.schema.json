{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/native.stop.proof.v1.schema.json",
  "title": "native.stop.proof/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "producer_module",
    "stopped",
    "submission_attempt_id",
    "command_id",
    "lease_id",
    "attempt",
    "native_request_binding_sha256",
    "submitted_request_sha256",
    "soul_id",
    "device_binding_id",
    "platform_account_id",
    "trace_id",
    "idempotency_key",
    "active_release_bom_sha256",
    "active_release_bom_generation",
    "active_release_bom_token_sha256",
    "worker_instance_id",
    "worker_generation",
    "stop_kind",
    "evidence_sha256",
    "occurred_at",
    "privacy_class",
    "auth_scope",
    "key_id",
    "signature_base64"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "native.stop.proof/v1"},
    "producer_module": {"const": "windows-edge-worker"},
    "stopped": {"const": true},
    "submission_attempt_id": {"$ref": "#/$defs/non_empty_uuid"},
    "command_id": {"$ref": "#/$defs/non_empty_uuid"},
    "lease_id": {"$ref": "#/$defs/non_empty_uuid"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "native_request_binding_sha256": {"$ref": "#/$defs/sha256"},
    "submitted_request_sha256": {"$ref": "#/$defs/sha256"},
    "soul_id": {"type": "string", "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": "string", "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": "string", "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "active_release_bom_sha256": {"$ref": "#/$defs/sha256"},
    "active_release_bom_generation": {"type": "integer", "minimum": 1},
    "active_release_bom_token_sha256": {"$ref": "#/$defs/sha256"},
    "worker_instance_id": {"type": "string", "pattern": "^wi_[a-f0-9]{32}$(?![\\s\\S])"},
    "worker_generation": {"type": "integer", "minimum": 1},
    "stop_kind": {"enum": ["NATIVE_NOT_STARTED", "NATIVE_TRANSPORT_ABORTED", "NATIVE_WORKER_PROCESS_EXITED"]},
    "evidence_sha256": {"$ref": "#/$defs/sha256"},
    "occurred_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$(?![\\s\\S])"},
    "privacy_class": {"const": "internal"},
    "auth_scope": {"const": "executor-gateway.native-stop-proof"},
    "key_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$(?![\\s\\S])"},
    "signature_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$(?![\\s\\S])"}
  },
  "$defs": {
    "non_empty_uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"}
  }
}
