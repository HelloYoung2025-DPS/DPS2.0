{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/native.submission.ack.v1.schema.json",
  "title": "native.submission.ack/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "producer_module",
    "submission_id",
    "completion_handle_id",
    "command_id",
    "lease_id",
    "attempt",
    "soul_id",
    "device_binding_id",
    "platform_account_id",
    "trace_id",
    "idempotency_key",
    "occurred_at",
    "privacy_class",
    "durability",
    "command_sha256",
    "authorization_sha256",
    "submission_attempt_id",
    "submission_intent_sha256",
    "pending_state_sha256",
    "active_release_bom_sha256",
    "active_release_bom_generation",
    "active_release_bom_token_sha256",
    "submitted_request_sha256",
    "acknowledgement_sha256"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1(?:\\.[0-9]+){0,2}$"},
    "contract_id": {"const": "native.submission.ack/v1"},
    "producer_module": {"const": "windows-edge-worker"},
    "submission_id": {"$ref": "#/$defs/non_empty_uuid"},
    "completion_handle_id": {"$ref": "#/$defs/non_empty_uuid"},
    "command_id": {"$ref": "#/$defs/non_empty_uuid"},
    "lease_id": {"$ref": "#/$defs/non_empty_uuid"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "soul_id": {"type": "string", "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": "string", "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": "string", "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$(?![\\s\\S])"},
    "privacy_class": {"const": "internal"},
    "durability": {"const": "REQUEST_AND_STATE_FLUSHED"},
    "command_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "authorization_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "submission_attempt_id": {"$ref": "#/$defs/non_empty_uuid"},
    "submission_intent_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "pending_state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "active_release_bom_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "active_release_bom_generation": {"type": "integer", "minimum": 1},
    "active_release_bom_token_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "submitted_request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "acknowledgement_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"}
  },
  "$defs": {
    "non_empty_uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
    }
  }
}
