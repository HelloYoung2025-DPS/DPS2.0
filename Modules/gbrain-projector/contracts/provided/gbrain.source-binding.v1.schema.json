{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/gbrain.source-binding.v1.schema.json",
  "title": "gbrain.source.binding/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "producer_module",
    "soul_id",
    "device_binding_id",
    "platform_account_id",
    "trace_id",
    "idempotency_key",
    "occurred_at",
    "privacy_class",
    "source_id",
    "algorithm",
    "nonce",
    "soul_hash",
    "allocated_at",
    "binding_revision",
    "binding_checksum"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "contract_id": { "const": "gbrain.source.binding/v1" },
    "producer_module": { "const": "gbrain-projector" },
    "soul_id": { "type": "string", "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])" },
    "device_binding_id": { "const": null },
    "platform_account_id": { "const": null },
    "trace_id": { "const": null },
    "idempotency_key": { "const": null },
    "occurred_at": { "type": "string", "maxLength": 32, "format": "date-time", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{0,6}[1-9])?Z$(?![\\s\\S])" },
    "privacy_class": { "const": "personal" },
    "source_id": { "type": "string", "minLength": 32, "maxLength": 32, "pattern": "^dps-[a-f0-9]{28}$(?![\\s\\S])" },
    "algorithm": { "const": "dps.gbrain-source-binding.sha256-nonce/v1" },
    "nonce": { "type": "integer", "minimum": 0, "maximum": 1023 },
    "soul_hash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])" },
    "allocated_at": { "type": "string", "maxLength": 32, "format": "date-time", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{0,6}[1-9])?Z$(?![\\s\\S])" },
    "binding_revision": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])" },
    "binding_checksum": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])" }
  }
}
