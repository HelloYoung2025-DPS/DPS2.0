<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);SYSLIB0014;SYSLIB0021</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <Compile Include="../src/BridgeContracts.cs" Link="LegacySource/BridgeContracts.cs" />
    <Compile Include="../src/BridgePeerProofVerifier.cs" Link="LegacySource/BridgePeerProofVerifier.cs" />
    <Compile Include="../src/BridgeProtocolValidator.cs" Link="LegacySource/BridgeProtocolValidator.cs" />
    <Compile Include="../src/LoopbackBridgeClient.cs" Link="LegacySource/LoopbackBridgeClient.cs" />
  </ItemGroup>
</Project>
