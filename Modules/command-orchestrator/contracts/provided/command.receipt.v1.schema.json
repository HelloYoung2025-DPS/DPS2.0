{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/command.receipt.v1.schema.json",
  "title": "command.receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "producer_module", "receipt_id", "command_id", "lease_id", "attempt", "soul_id", "device_binding_id", "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class", "outcome", "native_result_id", "native_result_verified", "postcondition_verified", "evidence_digest", "retry_allowed", "result_code"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1(?:\\.[0-9]+){0,2}$(?![\\s\\S])"}, "contract_id": {"const": "command.receipt/v1"}, "producer_module": {"const": "executor-gateway"},
    "receipt_id": {"type": "string", "format": "uuid"}, "command_id": {"type": "string", "format": "uuid"}, "lease_id": {"type": "string", "format": "uuid"}, "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "soul_id": {"type": "string", "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"}, "device_binding_id": {"type": "string", "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"}, "platform_account_id": {"type": "string", "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"}, "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"}, "occurred_at": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$(?![\\s\\S])"}, "privacy_class": {"const": "internal"},
    "outcome": {"enum": ["SUCCESS", "FAILED", "UNKNOWN_OUTCOME"]}, "native_result_id": {"type": ["string", "null"], "format": "uuid"}, "native_result_verified": {"type": "boolean"}, "postcondition_verified": {"type": "boolean"},
    "evidence_digest": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"}, "retry_allowed": {"type": "boolean"}, "result_code": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
