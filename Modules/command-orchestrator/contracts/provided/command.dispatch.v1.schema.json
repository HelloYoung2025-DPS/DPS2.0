{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/command.dispatch.v1.schema.json",
  "title": "command.dispatch/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "producer_module", "command_id", "operation_id", "approval_id", "approval_sha256", "soul_id", "device_binding_id", "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class", "action_kind", "is_side_effect", "platform_authorization_id", "lease_id", "lease_owner", "lease_expires_at", "attempt", "steps"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1(?:\\.[0-9]+){0,2}$(?![\\s\\S])"}, "contract_id": {"const": "command.dispatch/v1"}, "producer_module": {"const": "command-orchestrator"},
    "command_id": {"type": "string", "format": "uuid"}, "operation_id": {"type": "string", "format": "uuid"}, "approval_id": {"type": "string", "format": "uuid"}, "approval_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "soul_id": {"type": "string", "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"}, "device_binding_id": {"type": "string", "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"}, "platform_account_id": {"type": "string", "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"}, "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"}, "occurred_at": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$(?![\\s\\S])"}, "privacy_class": {"const": "internal"},
    "action_kind": {"enum": ["observe", "locate", "verify", "wait", "fixture.tap", "fixture.type"]}, "is_side_effect": {"type": "boolean"}, "platform_authorization_id": {"type": ["string", "null"], "maxLength": 256},
    "lease_id": {"type": "string", "format": "uuid"}, "lease_owner": {"type": "string", "minLength": 1, "maxLength": 128}, "lease_expires_at": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$(?![\\s\\S])"}, "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "steps": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["step_id", "step_kind", "arguments", "retry_safe", "postcondition_kind"], "properties": {"step_id": {"type": "string", "format": "uuid"}, "step_kind": {"enum": ["ui.observe", "ui.locate", "ui.verify", "control.wait", "fixture.tap", "fixture.type"]}, "arguments": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 256}}, "retry_safe": {"type": "boolean"}, "postcondition_kind": {"type": "string", "minLength": 1, "maxLength": 128}}}}
  }
}
