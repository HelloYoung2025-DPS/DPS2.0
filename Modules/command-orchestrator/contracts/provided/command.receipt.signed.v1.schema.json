{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/command.receipt.signed.v1.schema.json",
  "title": "command.receipt.signed/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "producer_module", "signature_domain", "canonical_encoding", "receipt_digest_algorithm", "command_digest_algorithm", "evidence_digest_algorithm", "signature_algorithm", "signature_format", "signature_encoding", "signer_module", "auth_scope", "receipt_id", "command_id", "lease_id", "attempt", "soul_id", "device_binding_id", "platform_account_id", "trace_id", "idempotency_key", "occurred_at", "privacy_class", "receipt_sha256", "command_sha256", "authorization_sha256", "release_bom_sha256", "active_release_bom_generation", "active_release_bom_token_sha256", "native_evidence_sha256", "postcondition_evidence_sha256", "receipt", "signature_base64"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1(?:\\.[0-9]+){0,2}$(?![\\s\\S])"},
    "contract_id": {"const": "command.receipt.signed/v1"},
    "producer_module": {"const": "executor-gateway"},
    "signature_domain": {"const": "dps.executor-gateway.command-receipt/v1"},
    "canonical_encoding": {"const": "dps.canonical.uint32be-length-prefixed-utf8/v1"},
    "receipt_digest_algorithm": {"const": "sha256:dps.command-orchestrator.command-receipt/v1"},
    "command_digest_algorithm": {"const": "sha256:dps.command-orchestrator.command-dispatch/v1"},
    "evidence_digest_algorithm": {"const": "sha256:dps.command-orchestrator.command-receipt-evidence/v1"},
    "signature_algorithm": {"const": "ecdsa-p256-sha256"},
    "signature_format": {"const": "ieee-p1363-fixed-field-concatenation"},
    "signature_encoding": {"const": "base64"},
    "signer_module": {"const": "executor-gateway"},
    "auth_scope": {"const": "command-orchestrator:receipt"},
    "receipt_id": {"type": "string", "format": "uuid"},
    "command_id": {"type": "string", "format": "uuid"},
    "lease_id": {"type": "string", "format": "uuid"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "soul_id": {"type": "string", "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": "string", "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": "string", "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "occurred_at": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$(?![\\s\\S])"},
    "privacy_class": {"const": "internal"},
    "receipt_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "command_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "authorization_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "release_bom_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "active_release_bom_generation": {"type": "integer", "minimum": 1},
    "active_release_bom_token_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "native_evidence_sha256": {"type": ["string", "null"], "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "postcondition_evidence_sha256": {"type": ["string", "null"], "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "receipt": {"$ref": "command.receipt.v1.schema.json"},
    "signature_base64": {
      "type": "string",
      "minLength": 88,
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]{86}==$(?![\\s\\S])",
      "contentEncoding": "base64"
    }
  }
}
