root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# Modern module sources are distinguishable from legacy `Modules/` only by
# their required `<module-id>/src` or `<module-id>/tests` structure on the
# case-insensitive target filesystems.
[Modules/*/src/**/*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[Modules/*/tests/**/*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Other explicitly modern service paths are normalized independently of
# legacy sources.
[{apps,tests,zenno}/**/*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Preserve the exact encoding and line endings already present in legacy
# ZennoDroid sources. Keep these narrow legacy overrides last so they win over
# repository defaults without affecting registered module src/tests.
[Core/*.cs]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[Core/**/*.cs]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[Modules/*.cs]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[Modules/Core/*.cs]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[Modules/Core/**/*.cs]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[ZDProjects/*.cs]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[ZDProjects/**/*.cs]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[Extensions/*.cs]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[Extensions/**/*.cs]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf
