{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/schemas/module-manifest.v2.schema.json",
  "title": "DPS module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "module",
    "paths",
    "artifacts",
    "runtime",
    "contracts",
    "communication",
    "dependencies",
    "permissions",
    "data",
    "security",
    "tests",
    "compatibility",
    "rollout",
    "deviceGates",
    "agents"
  ],
  "properties": {
    "schemaVersion": { "const": "dps.module/v2" },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "description",
        "lifecycle",
        "runtimeState",
        "releaseEligible",
        "riskTier",
        "ownerId"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/moduleId" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" },
        "description": { "type": "string", "minLength": 1 },
        "lifecycle": {
          "enum": ["proposed", "transitional", "active", "retired"]
        },
        "runtimeState": {
          "enum": ["proposed", "legacy-active", "active", "inactive"]
        },
        "releaseEligible": { "type": "boolean" },
        "riskTier": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
        "ownerId": { "$ref": "#/$defs/identifier" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actualRoot",
        "canonicalRoot",
        "owned",
        "excluded",
        "runtimeData"
      ],
      "properties": {
        "actualRoot": { "$ref": "#/$defs/repoPath" },
        "canonicalRoot": {
          "type": "string",
          "pattern": "^modules/[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "owned": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pathGlob" }
        },
        "excluded": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pathGlob" }
        },
        "runtimeData": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pathGlob" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "status", "build", "versioning"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "kind": {
            "enum": [
              "legacy-source-set",
              "assembly",
              "service",
              "contract-pack",
              "configuration-pack",
              "documentation"
            ]
          },
          "status": { "enum": ["proposed", "buildable", "retired"] },
          "build": { "type": ["string", "null"] },
          "versioning": { "enum": ["semver", "release-bom", "legacy"] }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track",
        "language",
        "target",
        "processBoundary",
        "entrypoints",
        "toolchainStatus"
      ],
      "properties": {
        "track": { "enum": ["legacy-zennodroid", "modern-service", "none"] },
        "language": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "processBoundary": {
          "enum": ["legacy-host", "modular-monolith", "out-of-process", "none"]
        },
        "entrypoints": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "toolchainStatus": { "enum": ["verified", "unverified", "proposed"] }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provided", "consumed"],
      "properties": {
        "provided": { "$ref": "#/$defs/providedContracts" },
        "consumed": { "$ref": "#/$defs/consumedContracts" }
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inbound", "outbound"],
      "properties": {
        "inbound": { "$ref": "#/$defs/communicationEdges" },
        "outbound": { "$ref": "#/$defs/communicationEdges" }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["moduleId", "versionRange", "required", "reason"],
        "properties": {
          "moduleId": { "$ref": "#/$defs/moduleId" },
          "versionRange": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "denied", "productionApproval"],
      "properties": {
        "allowed": { "$ref": "#/$defs/nonEmptyStrings" },
        "denied": { "$ref": "#/$defs/nonEmptyStrings" },
        "productionApproval": { "enum": ["not-applicable", "automatic", "human-required"] }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownedStores",
        "readModels",
        "privacyClasses",
        "retention",
        "export",
        "correction",
        "deletion"
      ],
      "properties": {
        "ownedStores": { "$ref": "#/$defs/strings" },
        "readModels": { "$ref": "#/$defs/strings" },
        "privacyClasses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["public", "internal", "personal", "sensitive", "secret"]
          }
        },
        "retention": { "type": "string", "minLength": 1 },
        "export": { "type": "string", "minLength": 1 },
        "correction": { "type": "string", "minLength": 1 },
        "deletion": { "type": "string", "minLength": 1 }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trustBoundaries", "secretScopes", "untrustedInputs", "failClosedOn", "policyIds"],
      "properties": {
        "trustBoundaries": { "$ref": "#/$defs/nonEmptyStrings" },
        "secretScopes": { "$ref": "#/$defs/strings" },
        "untrustedInputs": { "$ref": "#/$defs/strings" },
        "failClosedOn": { "$ref": "#/$defs/nonEmptyStrings" },
        "policyIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "pattern": "^[A-Z]+(?:-[A-Z]+)*-[0-9]{3}$", "type": "string" }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredOutcome", "failureOutcomes", "suites"],
      "properties": {
        "requiredOutcome": { "const": "PASS" },
        "failureOutcomes": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 6,
          "items": {
            "enum": ["FAIL", "SKIP", "PARTIAL", "NOT_RUN", "INFRA_ERROR", "NOT_APPLICABLE"]
          }
        },
        "suites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "required", "command", "environment", "evidenceLevel"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "type": { "enum": ["static", "unit", "contract", "integration", "windows", "device", "canary", "scale"] },
              "required": { "type": "boolean" },
              "command": { "type": ["string", "null"] },
              "environment": { "type": "string", "minLength": 1 },
              "evidenceLevel": { "$ref": "#/$defs/verificationLevel" }
            }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyRef",
        "track",
        "moduleMajor",
        "supportedContractMajors",
        "unknownMajorBehavior",
        "missingMajorBehavior",
        "unknownModeBehavior",
        "missingModeBehavior"
      ],
      "properties": {
        "policyRef": { "const": "governance/policies/compatibility-policy.yaml" },
        "track": { "enum": ["legacy", "modern", "bridge", "factory"] },
        "moduleMajor": { "type": "integer", "minimum": 0 },
        "supportedContractMajors": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1 }
          }
        },
        "unknownMajorBehavior": { "const": "reject" },
        "missingMajorBehavior": { "const": "reject" },
        "unknownModeBehavior": { "const": "reject" },
        "missingModeBehavior": { "const": "reject" }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featureFlag", "canary", "rollback", "killSwitch"],
      "properties": {
        "featureFlag": { "type": ["string", "null"] },
        "canary": { "type": "string", "minLength": 1 },
        "rollback": { "type": "string", "minLength": 1 },
        "killSwitch": { "type": ["string", "null"] }
      }
    },
    "deviceGates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresWindows", "requiresZennoDroid", "requiresAdb", "minimumVerification"],
      "properties": {
        "requiresWindows": { "type": "boolean" },
        "requiresZennoDroid": { "type": "boolean" },
        "requiresAdb": { "type": "boolean" },
        "minimumVerification": { "$ref": "#/$defs/verificationLevel" }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "policyVersion", "instructionsFile", "manifestFile", "receiptRequired"],
      "properties": {
        "spec": { "const": "dps.agents/v1" },
        "policyVersion": { "$ref": "#/$defs/semver" },
        "instructionsFile": { "const": "AGENTS.md" },
        "manifestFile": { "const": "module.yaml" },
        "receiptRequired": { "const": true }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "module": { "properties": { "lifecycle": { "const": "proposed" } } } }
      },
      "then": {
        "properties": { "module": { "properties": { "releaseEligible": { "const": false } } } }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "pathGlob": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "major", "source", "status", "mode", "ownerModule"],
      "properties": {
        "contractId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+)+$" },
        "major": { "type": "integer", "minimum": 1 },
        "source": { "$ref": "#/$defs/repoPath" },
        "status": { "enum": ["proposed", "active", "deprecated", "retired"] },
        "mode": { "$ref": "#/$defs/contractMajorMode" },
        "ownerModule": { "$ref": "#/$defs/moduleId" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "retired" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "mode": { "const": "retired" } }
          }
        },
        {
          "if": {
            "properties": { "mode": { "const": "retired" } },
            "required": ["mode"]
          },
          "then": {
            "properties": { "status": { "const": "retired" } }
          }
        }
      ]
    },
    "contractMajorMode": {
      "enum": ["active", "compat-read", "quarantine-only", "retired"]
    },
    "providedContractMajorMode": {
      "enum": ["active", "quarantine-only", "retired"]
    },
    "providedContract": {
      "allOf": [
        { "$ref": "#/$defs/contract" },
        {
          "properties": {
            "mode": { "$ref": "#/$defs/providedContractMajorMode" }
          }
        }
      ]
    },
    "providedContracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/providedContract" }
    },
    "consumedContracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/contract" }
    },
    "communicationEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peerModule",
        "contractId",
        "major",
        "direction",
        "transport",
        "timeoutMs",
        "retryPolicy",
        "idempotencyKey",
        "authScope",
        "failureMode"
      ],
      "properties": {
        "peerModule": { "$ref": "#/$defs/moduleId" },
        "contractId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+)+$" },
        "major": { "type": "integer", "minimum": 1 },
        "direction": { "enum": ["inbound", "outbound"] },
        "transport": {
          "enum": ["in-process-api", "http-api", "event", "command", "receipt", "read-only-query", "soul-memory-adapter"]
        },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 },
        "retryPolicy": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "authScope": { "type": "string", "minLength": 1 },
        "failureMode": { "type": "string", "minLength": 1 },
        "preserveProducer": { "type": "boolean", "default": false }
      }
    },
    "communicationEdges": {
      "type": "array",
      "items": { "$ref": "#/$defs/communicationEdge" }
    },
    "verificationLevel": {
      "enum": [
        "REPOSITORY_STATIC_VERIFIED",
        "CONTRACT_VERIFIED",
        "INTEGRATION_VERIFIED",
        "WINDOWS_VERIFIED",
        "DEVICE_VERIFIED",
        "CANARY_VERIFIED",
        "SCALE_VERIFIED"
      ]
    }
  }
}
