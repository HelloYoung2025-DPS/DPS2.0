{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/schemas/agents-frontmatter.schema.json",
  "title": "DPS module AGENTS front matter",
  "type": "object",
  "additionalProperties": false,
  "required": ["agents_spec", "policy_version", "module_id", "manifest", "applies_to"],
  "properties": {
    "agents_spec": { "const": "dps.agents/v1" },
    "policy_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "manifest": { "const": "./module.yaml" },
    "applies_to": { "const": "." }
  }
}
