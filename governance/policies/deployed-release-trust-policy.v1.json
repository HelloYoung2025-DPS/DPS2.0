{
  "schema_version": "dps.release-trust-policy/v1",
  "policy_id": "dps-deployed-release-anchor-v1",
  "required_gates": {
    "repository-static": {
      "kind": "REPOSITORY",
      "minimum_verification_level": "REPOSITORY_STATIC_VERIFIED"
    },
    "contract-verification": {
      "kind": "CONTRACT",
      "minimum_verification_level": "CONTRACT_VERIFIED"
    },
    "integration-verification": {
      "kind": "INTEGRATION",
      "minimum_verification_level": "INTEGRATION_VERIFIED"
    }
  },
  "implementer_identities": [
    "deployed-module-builder"
  ],
  "evidence_issuer_identities": [
    "deployed-evidence-issuer"
  ],
  "release_controller_identities": [
    "deployed-release-controller",
    "deployed-artifact-signer"
  ],
  "release_approver_identities": [
    "deployed-human-approver"
  ],
  "native_stop_trust_signer_identities": [
    "owner-native-stop-trust-signer-1"
  ],
  "allow_bootstrap": false,
  "keys": [
    {
      "key_id": "deployed-controller-key-v1",
      "identity": "deployed-release-controller",
      "algorithm": "rsa-pss-sha256",
      "modulus_hex": "",
      "exponent": 65537,
      "purposes": ["bom"]
    },
    {
      "key_id": "deployed-artifact-key-v1",
      "identity": "deployed-artifact-signer",
      "algorithm": "rsa-pss-sha256",
      "modulus_hex": "",
      "exponent": 65537,
      "purposes": ["artifact"]
    },
    {
      "key_id": "deployed-evidence-key-v1",
      "identity": "deployed-evidence-issuer",
      "algorithm": "rsa-pss-sha256",
      "modulus_hex": "",
      "exponent": 65537,
      "purposes": ["evidence"]
    },
    {
      "key_id": "deployed-approval-key-v1",
      "identity": "deployed-human-approver",
      "algorithm": "rsa-pss-sha256",
      "modulus_hex": "",
      "exponent": 65537,
      "purposes": ["approval"]
    },
    {
      "key_id": "native-stop-trust-owner-key-1",
      "identity": "owner-native-stop-trust-signer-1",
      "algorithm": "rsa-pss-sha256",
      "modulus_hex": "",
      "exponent": 65537,
      "purposes": ["native-stop-trust"]
    }
  ]
}
