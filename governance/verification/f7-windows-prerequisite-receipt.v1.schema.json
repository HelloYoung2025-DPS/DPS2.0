{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/verification/f7-windows-prerequisite-receipt.v1.schema.json",
  "title": "Signed F6 Windows prerequisite receipt consumed by F7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "repository_id",
    "source_stage",
    "verification_level",
    "status",
    "required",
    "evidence_kind",
    "evidence_id",
    "source_evidence_sha256",
    "source_environment_id",
    "source_environment_sha256",
    "source_measurement_started_at",
    "source_measurement_finished_at",
    "edge_installation_id",
    "zenno_installation_id",
    "baseline_commit",
    "release_bom_id",
    "release_bom_sha256",
    "candidate_artifact_sha256",
    "trust_policy_id",
    "trust_policy_sha256",
    "issued_at",
    "expires_at",
    "evidence_issuer_identity",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "dps.f7-windows-prerequisite-receipt/v1" },
    "receipt_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
    "repository_id": { "type": "string", "pattern": "^repo:[a-z0-9]+(?:[._/-][a-z0-9]+)*$" },
    "source_stage": { "const": "f6" },
    "verification_level": { "const": "WINDOWS_VERIFIED" },
    "status": { "const": "PASS" },
    "required": { "const": true },
    "evidence_kind": { "const": "REAL_EXTERNAL" },
    "evidence_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
    "source_evidence_sha256": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/sha256" },
    "source_environment_id": { "type": "string", "pattern": "^env_[a-z0-9][a-z0-9_-]{6,63}$" },
    "source_environment_sha256": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/sha256" },
    "source_measurement_started_at": { "type": "string", "format": "date-time" },
    "source_measurement_finished_at": { "type": "string", "format": "date-time" },
    "edge_installation_id": { "type": "string", "pattern": "^edge_[a-z0-9][a-z0-9_-]{6,63}$" },
    "zenno_installation_id": { "type": "string", "pattern": "^zenno_[a-z0-9][a-z0-9_-]{6,63}$" },
    "baseline_commit": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/gitObject" },
    "release_bom_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
    "release_bom_sha256": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/sha256" },
    "candidate_artifact_sha256": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/sha256" },
    "trust_policy_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
    "trust_policy_sha256": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/sha256" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "evidence_issuer_identity": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/identity" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "runner_key_id", "value"],
      "properties": {
        "algorithm": { "const": "ECDSA_P256_SHA256_P1363" },
        "runner_key_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
        "value": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
