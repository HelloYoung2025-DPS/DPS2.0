{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/verification/f9-compatibility-combination-observation.v1.schema.json",
  "title": "F9 raw compatibility combination observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "evidence_kind",
    "matrix_row_id",
    "combination_id",
    "expectation",
    "environment_id",
    "candidate_bom_sha256",
    "previous_stable_bom_sha256",
    "compatibility_snapshot_sha256",
    "producer",
    "consumer",
    "started_at",
    "finished_at",
    "executed_test_count",
    "skip_count",
    "partial_count",
    "not_run_count",
    "observed_outcome",
    "side_effect_count",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "dps.compatibility-combination-observation/v1" },
    "artifact_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
    "evidence_kind": { "const": "REAL_EXTERNAL" },
    "matrix_row_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
    "combination_id": { "enum": ["N/N", "N/N-1", "N-1/N", "N-1/N-1"] },
    "expectation": { "enum": ["RUNNABLE", "FAIL_CLOSED_BY_GROUP"] },
    "environment_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
    "candidate_bom_sha256": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/sha256" },
    "previous_stable_bom_sha256": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/sha256" },
    "compatibility_snapshot_sha256": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/sha256" },
    "producer": { "$ref": "f9-compatibility-execution-evidence.v1.schema.json#/$defs/moduleSelection" },
    "consumer": { "$ref": "f9-compatibility-execution-evidence.v1.schema.json#/$defs/moduleSelection" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "executed_test_count": { "type": "integer", "minimum": 1 },
    "skip_count": { "const": 0 },
    "partial_count": { "const": 0 },
    "not_run_count": { "const": 0 },
    "observed_outcome": { "enum": ["RUNNABLE", "FAIL_CLOSED"] },
    "side_effect_count": { "const": 0 },
    "status": { "const": "PASS" }
  }
}
