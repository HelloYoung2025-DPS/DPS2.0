{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/verification/f9-module-dependency-dag.v1.schema.json",
  "title": "F9 canonical module dependency graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedFrom", "failOnCycle", "nodes", "edges", "parallelWaves"],
  "properties": {
    "schemaVersion": { "const": "dps.dependency-graph/v1" },
    "generatedFrom": { "const": "Modules/*/module.yaml" },
    "failOnCycle": { "const": true },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/moduleId" }
    },
    "edges": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consumer", "provider", "reason"],
        "properties": {
          "consumer": { "$ref": "#/$defs/moduleId" },
          "provider": { "$ref": "#/$defs/moduleId" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "parallelWaves": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/moduleId" }
      }
    }
  },
  "$defs": {
    "moduleId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
  }
}
