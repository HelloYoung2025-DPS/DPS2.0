{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/verification/external-evidence-envelope.v1.schema.json",
  "title": "DPS external verification evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "evidence_kind",
    "required",
    "status",
    "baseline_commit",
    "release_bom",
    "environment",
    "measurement_window",
    "raw_artifacts",
    "factory_binding",
    "payload",
    "attestation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^dps\\.[a-z0-9-]+-verification-input/v[1-9][0-9]*$"
    },
    "evidence_id": { "$ref": "#/$defs/id" },
    "evidence_kind": {
      "enum": ["REAL_EXTERNAL", "MOCK", "SIMULATED", "HOSTED"]
    },
    "required": { "type": "boolean" },
    "status": {
      "enum": ["PASS", "FAIL", "SKIP", "PARTIAL", "NOT_RUN", "INFRA_ERROR", "NOT_APPLICABLE"]
    },
    "baseline_commit": { "$ref": "#/$defs/gitObject" },
    "release_bom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bom_id", "status", "path", "sha256", "artifact_sha256"],
      "properties": {
        "bom_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["SIGNED", "DEPLOYING", "STABLE"] },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "environment": {
      "type": "object",
      "description": "The executable stage validator selects an exact subset. F6 trust-pins the full Windows/Zenno/.NET/C#/CodeDom/GAC/load/ADB/Bridge/loopback/timeout/error/continuity tuple; F7 pins GBrain deployment; F8-F9 pin environment and OS. No free-form fields are accepted.",
      "additionalProperties": false,
      "properties": {
        "environment_id": { "type": "string", "pattern": "^env_[a-z0-9][a-z0-9_-]{6,63}$" },
        "os_family": { "enum": ["Windows", "Android", "Windows+Android", "Linux"] },
        "windows_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
        "zennodroid_version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "gbrain_deployment_id": {
          "type": "string",
          "pattern": "^gbrain_[a-z0-9][a-z0-9_-]{6,63}$"
        },
        "dotnet_framework_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
        "csharp_language_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
        "codedom_compile": { "const": "PASS" },
        "gac_resolution": { "const": "PASS" },
        "dll_load": { "const": "PASS" },
        "zenno_project_load": { "const": "PASS" },
        "bridge_abi": { "type": "string", "pattern": "^dps\\.zenno-bridge/v[1-9][0-9]*$" },
        "adb_authorized_device_count": { "type": "integer", "minimum": 1 },
        "adb_authorization": { "const": "PASS" },
        "loopback_host": { "const": "127.0.0.1" },
        "loopback_port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "loopback_port_fixed": { "const": true },
        "loopback_only": { "const": true },
        "command_timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 300 },
        "timeout_semantics": { "const": "FAIL_CLOSED" },
        "error_semantics": { "const": "NATIVE_ERROR_PRESERVED" },
        "connection_continuity": { "const": "PASS" }
      },
      "required": ["environment_id", "os_family"]
    },
    "measurement_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" }
      }
    },
    "raw_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "path", "sha256", "size_bytes", "media_type"],
        "properties": {
          "artifact_id": { "$ref": "#/$defs/id" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "media_type": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "factory_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upgrade_stream_id",
        "instruction_receipt_id",
        "source_event_sha256",
        "implementer_identity",
        "evidence_issuer_identity",
        "release_approver_identity"
      ],
      "properties": {
        "upgrade_stream_id": { "$ref": "#/$defs/id" },
        "instruction_receipt_id": { "$ref": "#/$defs/id" },
        "source_event_sha256": { "$ref": "#/$defs/sha256" },
        "implementer_identity": { "$ref": "#/$defs/identity" },
        "evidence_issuer_identity": { "$ref": "#/$defs/identity" },
        "release_approver_identity": { "$ref": "#/$defs/identity" }
      }
    },
    "payload": { "type": "object" },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "signature_base64"],
      "properties": {
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "runner_key_id",
            "algorithm",
            "issued_at",
            "payload_sha256",
            "evidence_issuer_identity",
            "raw_artifacts_observed",
            "role_separation_verified",
            "real_environment_observed"
          ],
          "properties": {
            "schema_version": { "const": "1.0.0" },
            "runner_key_id": { "$ref": "#/$defs/id" },
            "algorithm": { "const": "ECDSA_P256_SHA256_P1363" },
            "issued_at": { "type": "string", "format": "date-time" },
            "payload_sha256": { "$ref": "#/$defs/sha256" },
            "evidence_issuer_identity": { "$ref": "#/$defs/identity" },
            "raw_artifacts_observed": { "const": true },
            "role_separation_verified": { "const": true },
            "real_environment_observed": { "const": true }
          }
        },
        "signature_base64": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{7,127}$"
    },
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,127}$"
    },
    "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "outcome": { "enum": ["PASS", "FAIL", "SKIP", "PARTIAL", "NOT_RUN", "INFRA_ERROR"] },
    "datedWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
