{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/verification/external-trust-policy.v1.schema.json",
  "title": "DPS externally injected verification trust policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "trusted_issuers", "trusted_bom_signers", "environment_policies"],
  "properties": {
    "schema_version": { "const": "dps.external-verification-trust-policy/v1" },
    "policy_id": { "$ref": "#/$defs/id" },
    "trusted_issuers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issuer_identity",
          "runner_key_id",
          "algorithm",
          "public_key_pem_path",
          "public_key_sha256",
          "allowed_verification_levels"
        ],
        "properties": {
          "issuer_identity": { "$ref": "#/$defs/identity" },
          "runner_key_id": { "$ref": "#/$defs/id" },
          "algorithm": { "const": "ECDSA_P256_SHA256_P1363" },
          "public_key_pem_path": { "type": "string", "minLength": 1 },
          "public_key_sha256": { "$ref": "#/$defs/sha256" },
          "allowed_verification_levels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["WINDOWS_VERIFIED", "DEVICE_VERIFIED", "CANARY_VERIFIED", "SCALE_VERIFIED"]
            }
          }
        }
      }
    },
    "trusted_bom_signers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "public_key_pem_path", "public_key_sha256"],
        "properties": {
          "key_id": { "$ref": "#/$defs/id" },
          "algorithm": { "const": "ecdsa-p256-sha256" },
          "public_key_pem_path": { "type": "string", "minLength": 1 },
          "public_key_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "prerequisite_receipt_policy": {
      "type": "object",
      "description": "Required by F7. The current externally managed policy binds repository identity, receipt currentness, clock skew, and explicit revocations.",
      "additionalProperties": false,
      "required": ["repository_id", "maximum_age_seconds", "maximum_clock_skew_seconds", "revoked_receipt_ids", "required_source_evidence"],
      "properties": {
        "repository_id": { "type": "string", "pattern": "^repo:[a-z0-9]+(?:[._/-][a-z0-9]+)*$" },
        "maximum_age_seconds": { "type": "integer", "minimum": 1, "maximum": 2678400 },
        "maximum_clock_skew_seconds": { "type": "integer", "minimum": 0, "maximum": 300 },
        "revoked_receipt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "required_source_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_id", "evidence_sha256", "environment_id", "environment_sha256", "measurement_started_at", "measurement_finished_at", "edge_installation_id", "zenno_installation_id"],
          "properties": {
            "evidence_id": { "$ref": "#/$defs/id" },
            "evidence_sha256": { "$ref": "#/$defs/sha256" },
            "environment_id": { "type": "string", "pattern": "^env_[a-z0-9][a-z0-9_-]{6,63}$" },
            "environment_sha256": { "$ref": "#/$defs/sha256" },
            "measurement_started_at": { "type": "string", "format": "date-time" },
            "measurement_finished_at": { "type": "string", "format": "date-time" },
            "edge_installation_id": { "type": "string", "pattern": "^edge_[a-z0-9][a-z0-9_-]{6,63}$" },
            "zenno_installation_id": { "type": "string", "pattern": "^zenno_[a-z0-9][a-z0-9_-]{6,63}$" }
          }
        }
      }
    },
    "environment_policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verification_level", "required_claims"],
        "properties": {
          "verification_level": {
            "enum": ["WINDOWS_VERIFIED", "DEVICE_VERIFIED", "CANARY_VERIFIED", "SCALE_VERIFIED"]
          },
          "required_claims": {
            "type": "object",
            "minProperties": 2,
            "description": "Expected values for the stage's fixed environment claim-name allowlist. No free-form fields or values are accepted by the executable validator.",
            "additionalProperties": false,
            "properties": {
              "environment_id": { "type": "string", "pattern": "^env_[a-z0-9][a-z0-9_-]{6,63}$" },
              "os_family": { "enum": ["Windows", "Android", "Windows+Android", "Linux"] },
              "windows_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
              "zennodroid_version": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][A-Za-z0-9.-]+)?$"
              },
              "gbrain_deployment_id": {
                "type": "string",
                "pattern": "^gbrain_[a-z0-9][a-z0-9_-]{6,63}$"
              },
              "dotnet_framework_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
              "csharp_language_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
              "codedom_compile": { "const": "PASS" },
              "gac_resolution": { "const": "PASS" },
              "dll_load": { "const": "PASS" },
              "zenno_project_load": { "const": "PASS" },
              "bridge_abi": { "type": "string", "pattern": "^dps\\.zenno-bridge/v[1-9][0-9]*$" },
              "adb_authorized_device_count": { "type": "integer", "minimum": 1 },
              "adb_authorization": { "const": "PASS" },
              "loopback_host": { "const": "127.0.0.1" },
              "loopback_port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
              "loopback_port_fixed": { "const": true },
              "loopback_only": { "const": true },
              "command_timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 300 },
              "timeout_semantics": { "const": "FAIL_CLOSED" },
              "error_semantics": { "const": "NATIVE_ERROR_PRESERVED" },
              "connection_continuity": { "const": "PASS" }
            },
            "required": ["environment_id", "os_family"]
          }
        },
        "oneOf": [
          {
            "properties": {
              "verification_level": { "const": "WINDOWS_VERIFIED" },
              "required_claims": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "environment_id",
                  "os_family",
                  "windows_version",
                  "zennodroid_version",
                  "dotnet_framework_version",
                  "csharp_language_version",
                  "codedom_compile",
                  "gac_resolution",
                  "dll_load",
                  "zenno_project_load",
                  "bridge_abi",
                  "adb_authorized_device_count",
                  "adb_authorization",
                  "loopback_host",
                  "loopback_port",
                  "loopback_port_fixed",
                  "loopback_only",
                  "command_timeout_seconds",
                  "timeout_semantics",
                  "error_semantics",
                  "connection_continuity"
                ],
                "properties": {
                  "environment_id": { "type": "string", "pattern": "^env_[a-z0-9][a-z0-9_-]{6,63}$" },
                  "os_family": { "const": "Windows" },
                  "windows_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
                  "zennodroid_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][A-Za-z0-9.-]+)?$" },
                  "dotnet_framework_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
                  "csharp_language_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
                  "codedom_compile": { "const": "PASS" },
                  "gac_resolution": { "const": "PASS" },
                  "dll_load": { "const": "PASS" },
                  "zenno_project_load": { "const": "PASS" },
                  "bridge_abi": { "type": "string", "pattern": "^dps\\.zenno-bridge/v[1-9][0-9]*$" },
                  "adb_authorized_device_count": { "type": "integer", "minimum": 1 },
                  "adb_authorization": { "const": "PASS" },
                  "loopback_host": { "const": "127.0.0.1" },
                  "loopback_port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
                  "loopback_port_fixed": { "const": true },
                  "loopback_only": { "const": true },
                  "command_timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 300 },
                  "timeout_semantics": { "const": "FAIL_CLOSED" },
                  "error_semantics": { "const": "NATIVE_ERROR_PRESERVED" },
                  "connection_continuity": { "const": "PASS" }
                }
              }
            }
          },
          {
            "properties": {
              "verification_level": { "const": "DEVICE_VERIFIED" },
              "required_claims": {
                "type": "object",
                "additionalProperties": false,
                "required": ["environment_id", "os_family", "gbrain_deployment_id"],
                "properties": {
                  "environment_id": { "type": "string", "pattern": "^env_[a-z0-9][a-z0-9_-]{6,63}$" },
                  "os_family": { "const": "Windows+Android" },
                  "gbrain_deployment_id": { "type": "string", "pattern": "^gbrain_[a-z0-9][a-z0-9_-]{6,63}$" }
                }
              }
            }
          },
          {
            "properties": {
              "verification_level": { "const": "CANARY_VERIFIED" },
              "required_claims": {
                "type": "object",
                "additionalProperties": false,
                "required": ["environment_id", "os_family"],
                "properties": {
                  "environment_id": { "type": "string", "pattern": "^env_[a-z0-9][a-z0-9_-]{6,63}$" },
                  "os_family": { "enum": ["Windows", "Android", "Windows+Android", "Linux"] }
                }
              }
            }
          },
          {
            "properties": {
              "verification_level": { "const": "SCALE_VERIFIED" },
              "required_claims": {
                "type": "object",
                "additionalProperties": false,
                "required": ["environment_id", "os_family"],
                "properties": {
                  "environment_id": { "type": "string", "pattern": "^env_[a-z0-9][a-z0-9_-]{6,63}$" },
                  "os_family": { "enum": ["Windows", "Android", "Windows+Android", "Linux"] }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{7,127}$" },
    "identity": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
