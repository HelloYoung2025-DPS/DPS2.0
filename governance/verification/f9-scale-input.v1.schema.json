{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/verification/f9-scale-input.v1.schema.json",
  "title": "F9 two-hundred-device scale evidence",
  "allOf": [
    { "$ref": "external-evidence-envelope.v1.schema.json" },
    {
      "type": "object",
      "required": ["schema_version", "payload"],
      "properties": {
        "schema_version": { "const": "dps.scale-verification-input/v1" },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["environment_id", "os_family"],
          "properties": {
            "environment_id": { "type": "string", "pattern": "^env_[a-z0-9][a-z0-9_-]{6,63}$" },
            "os_family": { "enum": ["Windows", "Android", "Windows+Android", "Linux"] }
          }
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "waves",
            "canary_prerequisite",
            "module_rollout_lines",
            "managed_devices",
            "load_runs",
            "control_plane_instances",
            "postgres_restore",
            "gbrain_capacity",
            "crash_recovery",
            "rollback_drills",
            "soak",
            "previous_stable_bom",
            "legacy_runtime_adapter"
          ],
          "properties": {
            "canary_prerequisite": {
              "type": "object",
              "additionalProperties": false,
              "required": ["receipt_id", "raw_artifact_id", "raw_artifact_sha256"],
              "properties": {
                "receipt_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
                "raw_artifact_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
                "raw_artifact_sha256": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/sha256" }
              }
            },
            "module_rollout_lines": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dependency_graph_artifact_id",
                "dependency_graph_sha256",
                "compatibility_matrix_artifact_id",
                "compatibility_matrix_sha256",
                "compatibility_policy_artifact_id",
                "compatibility_policy_sha256",
                "previous_stable_bom_artifact_id",
                "previous_stable_bom_sha256",
                "compatibility_execution_artifact_id",
                "compatibility_execution_sha256",
                "manifest_artifacts",
                "manifest_schema_artifacts",
                "contract_schema_artifacts",
                "lines"
              ],
              "properties": {
                "dependency_graph_artifact_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
                "dependency_graph_sha256": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/sha256" },
                "compatibility_matrix_artifact_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
                "compatibility_matrix_sha256": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/sha256" },
                "compatibility_policy_artifact_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
                "compatibility_policy_sha256": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/sha256" },
                "previous_stable_bom_artifact_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
                "previous_stable_bom_sha256": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/sha256" },
                "compatibility_execution_artifact_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
                "compatibility_execution_sha256": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/sha256" },
                "manifest_artifacts": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4096,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["module_id", "raw_artifact_id", "manifest_sha256"],
                    "properties": {
                      "module_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                      "raw_artifact_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
                      "manifest_sha256": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/sha256" }
                    }
                  }
                },
                "manifest_schema_artifacts": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["schema_version", "raw_artifact_id", "schema_sha256"],
                    "properties": {
                      "schema_version": { "type": "string", "pattern": "^dps\\.module/v[1-9][0-9]*$" },
                      "raw_artifact_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
                      "schema_sha256": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/sha256" }
                    }
                  }
                },
                "contract_schema_artifacts": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 131072,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["contract_id", "major", "owner_module", "raw_artifact_id", "schema_sha256"],
                    "properties": {
                      "contract_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+)+$" },
                      "major": { "type": "integer", "minimum": 1 },
                      "owner_module": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                      "raw_artifact_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
                      "schema_sha256": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/sha256" }
                    }
                  }
                },
                "lines": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["line_id", "module_ids", "status"],
                    "properties": {
                      "line_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
                      "module_ids": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
                      },
                      "status": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/outcome" }
                    }
                  }
                }
              }
            },
            "waves": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "device_count", "started_at", "finished_at", "status"],
                "properties": {
                  "name": { "enum": ["2", "10", "20", "50", "100", "200"] },
                  "device_count": { "enum": [2, 10, 20, 50, 100, 200] },
                  "started_at": { "type": "string", "format": "date-time" },
                  "finished_at": { "type": "string", "format": "date-time" },
                  "status": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/outcome" }
                }
              }
            },
            "managed_devices": { "type": "integer", "minimum": 200 },
            "load_runs": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sustained", "burst", "simulated"],
              "properties": {
                "sustained": { "$ref": "f9-scale-input.v1.schema.json#/$defs/realLoad" },
                "burst": { "$ref": "f9-scale-input.v1.schema.json#/$defs/realLoad" },
                "simulated": { "$ref": "f9-scale-input.v1.schema.json#/$defs/simulatedLoad" }
              }
            },
            "control_plane_instances": { "type": "integer", "minimum": 2 },
            "postgres_restore": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "declared_rpo_minutes", "measured_rpo_minutes", "declared_rto_minutes", "measured_rto_minutes"],
              "properties": {
                "status": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/outcome" },
                "declared_rpo_minutes": { "type": "number", "exclusiveMinimum": 0 },
                "measured_rpo_minutes": { "type": "number", "minimum": 0 },
                "declared_rto_minutes": { "type": "number", "exclusiveMinimum": 0 },
                "measured_rto_minutes": { "type": "number", "minimum": 0 }
              }
            },
            "gbrain_capacity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "modeled_sources", "oauth_clients", "connection_budget", "projection_capacity_devices"],
              "properties": {
                "status": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/outcome" },
                "modeled_sources": { "type": "integer", "minimum": 200 },
                "oauth_clients": { "type": "integer", "minimum": 1 },
                "connection_budget": { "type": "integer", "minimum": 1 },
                "projection_capacity_devices": { "type": "integer", "minimum": 200 }
              }
            },
            "crash_recovery": {
              "type": "object",
              "additionalProperties": false,
              "required": ["factory", "control_plane", "edge_worker"],
              "properties": {
                "factory": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/outcome" },
                "control_plane": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/outcome" },
                "edge_worker": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/outcome" }
              }
            },
            "rollback_drills": {
              "type": "array",
              "minItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["scope", "status", "duration_minutes"],
                "properties": {
                  "scope": { "enum": ["site", "database", "edge", "gbrain", "module"] },
                  "status": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/outcome" },
                  "duration_minutes": { "type": "number", "minimum": 0 }
                },
                "allOf": [
                  {
                    "if": { "properties": { "scope": { "const": "module" } }, "required": ["scope"] },
                    "then": { "properties": { "duration_minutes": { "maximum": 5 } } }
                  }
                ]
              }
            },
            "soak": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "duration_hours", "cross_scope_leaks", "unauthorized_side_effects", "duplicate_side_effects", "false_successes", "long_term_backlog"],
              "properties": {
                "status": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/outcome" },
                "duration_hours": { "type": "number", "minimum": 72 },
                "cross_scope_leaks": { "const": 0 },
                "unauthorized_side_effects": { "const": 0 },
                "duplicate_side_effects": { "const": 0 },
                "false_successes": { "const": 0 },
                "long_term_backlog": { "const": false }
              }
            },
            "previous_stable_bom": {
              "type": "object",
              "additionalProperties": false,
              "required": ["available", "artifacts_available", "compatible_schema_available"],
              "properties": {
                "available": { "const": true },
                "artifacts_available": { "const": true },
                "compatible_schema_available": { "const": true }
              }
            },
            "legacy_runtime_adapter": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "remaining_entries_documented"],
              "properties": {
                "status": { "enum": ["RETIRED", "COMPATIBILITY_ONLY"] },
                "remaining_entries_documented": { "const": true }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "realLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "artifact_id", "evidence_kind", "concurrency", "duration_seconds", "started_at", "finished_at", "status", "recovered_without_long_term_backlog", "artifact_sha256"],
      "properties": {
        "run_id": { "type": "string", "minLength": 8 },
        "artifact_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
        "evidence_kind": { "const": "REAL_EXTERNAL" },
        "concurrency": { "type": "integer", "minimum": 1 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "status": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/outcome" },
        "recovered_without_long_term_backlog": { "const": true },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "simulatedLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "artifact_id", "evidence_kind", "concurrency", "duration_seconds", "started_at", "finished_at", "status", "recovered_without_long_term_backlog", "artifact_sha256"],
      "properties": {
        "run_id": { "type": "string", "minLength": 8 },
        "artifact_id": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/id" },
        "evidence_kind": { "const": "SIMULATED" },
        "concurrency": { "type": "integer", "minimum": 400 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "status": { "$ref": "external-evidence-envelope.v1.schema.json#/$defs/outcome" },
        "recovered_without_long_term_backlog": { "const": true },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
